{
  "$defs": {
    "MapData": {
      "properties": {
        "building_id": {
          "enum": [
            "v5",
            "rooms_a"
          ],
          "title": "Building Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "floor_id": {
          "enum": [
            "floor1",
            "floor2"
          ],
          "title": "Floor Id",
          "type": "string"
        },
        "height": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "map_source": {
          "enum": [
            "slam",
            "gt_raster"
          ],
          "title": "Map Source",
          "type": "string"
        },
        "map_version": {
          "title": "Map Version",
          "type": "string"
        },
        "origin": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Origin",
          "type": "array"
        },
        "png": {
          "title": "Png",
          "type": "string"
        },
        "resolution": {
          "exclusiveMinimum": 0,
          "title": "Resolution",
          "type": "number"
        },
        "saved_sim_t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Saved Sim T"
        },
        "width": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "world_id": {
          "enum": [
            "v5_single",
            "v5_building",
            "rooms_a"
          ],
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "world_id",
        "building_id",
        "floor_id",
        "map_version",
        "map_source",
        "epoch",
        "resolution",
        "origin",
        "width",
        "height",
        "saved_sim_t",
        "png"
      ],
      "title": "MapData",
      "type": "object"
    },
    "MapInfo": {
      "description": "저장 지도 meta 요약(서버가 sha·크기 검증을 마친 것만). 행 순서는 PGM 그대로 — 첫 행 = y 가 가장 큰 쪽, origin = 왼쪽 아래 칸의 월드 좌표.",
      "properties": {
        "building_id": {
          "enum": [
            "v5",
            "rooms_a"
          ],
          "title": "Building Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "floor_id": {
          "enum": [
            "floor1",
            "floor2"
          ],
          "title": "Floor Id",
          "type": "string"
        },
        "height": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "map_source": {
          "enum": [
            "slam",
            "gt_raster"
          ],
          "title": "Map Source",
          "type": "string"
        },
        "map_version": {
          "title": "Map Version",
          "type": "string"
        },
        "origin": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Origin",
          "type": "array"
        },
        "resolution": {
          "exclusiveMinimum": 0,
          "title": "Resolution",
          "type": "number"
        },
        "saved_sim_t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Saved Sim T"
        },
        "width": {
          "maximum": 2000,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "world_id": {
          "enum": [
            "v5_single",
            "v5_building",
            "rooms_a"
          ],
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "world_id",
        "building_id",
        "floor_id",
        "map_version",
        "map_source",
        "epoch",
        "resolution",
        "origin",
        "width",
        "height",
        "saved_sim_t"
      ],
      "title": "MapInfo",
      "type": "object"
    },
    "PhotoMeta": {
      "description": "photos.jsonl 한 줄 = 사진 저장 응답. 위치는 저장 요청 때의 최신 GT(프레임 동기 아님).",
      "properties": {
        "by": {
          "title": "By",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "camera": {
          "title": "Camera",
          "type": "string"
        },
        "episode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Episode"
        },
        "frame_at": {
          "title": "Frame At",
          "type": "string"
        },
        "frame_stamp_sim_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Stamp Sim S"
        },
        "gt_age_s": {
          "title": "Gt Age S",
          "type": "number"
        },
        "gt_note": {
          "title": "Gt Note",
          "type": "string"
        },
        "saved_at": {
          "title": "Saved At",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        },
        "url": {
          "pattern": "^media/photos/[0-9]{8}/[A-Za-z0-9_.-]{1,80}\\.jpg$",
          "title": "Url",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yaw"
        }
      },
      "required": [
        "frame_at",
        "frame_stamp_sim_s",
        "episode",
        "by",
        "source",
        "x",
        "y",
        "yaw",
        "gt_note",
        "gt_age_s",
        "camera",
        "saved_at",
        "bytes",
        "url"
      ],
      "title": "PhotoMeta",
      "type": "object"
    }
  },
  "$id": "fh-app/1/Reply",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "map": {
      "anyOf": [
        {
          "$ref": "#/$defs/MapData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "maps": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/MapInfo"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maps"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "op": {
      "const": "reply",
      "title": "Op",
      "type": "string"
    },
    "photo": {
      "anyOf": [
        {
          "$ref": "#/$defs/PhotoMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Rid"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "op",
    "rid",
    "ok",
    "text"
  ],
  "title": "Reply",
  "type": "object"
}
