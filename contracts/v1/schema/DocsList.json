            "$ref": "#/$defs/TmplMod"
          },
          "maxItems": 6,
          "title": "Mods",
          "type": "array"
        },
        "name": {
          "maxLength": 60,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "desc",
        "mods"
      ],
      "title": "Tmpl",
      "type": "object"
    },
    "TmplEnv": {
      "properties": {
