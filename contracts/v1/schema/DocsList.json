{
  "$defs": {
    "MapSrc": {
      "additionalProperties": false,
      "description": "좌표 출처(선택 키 map — 없음 = «지도 미확인 · 기록만», null 불가). 지점을 찍거나 가져온 때의 GT world·현재층.\nkey = 그때 좌표 지문(앱이 계산·대조 — 출처를 모르는 옛 앱이 좌표를 고치면 어긋나 미확인으로 떨어짐). SLAM 계획은 지원 미확인(src gt 만).",
      "properties": {
        "floor_id": {
          "maxLength": 40,
          "title": "Floor Id",
          "type": "string"
        },
        "key": {
          "maxLength": 16,
          "title": "Key",
          "type": "string"
        },
        "rid": {
          "default": null,
          "pattern": "^[wg]:[0-9a-f]{64}$",
          "title": "Rid",
          "type": "string"
        },
        "src": {
          "const": "gt",
          "title": "Src",
          "type": "string"
        },
        "world_id": {
          "maxLength": 40,
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "src",
        "world_id",
        "floor_id",
        "key"
      ],
      "title": "MapSrc",
      "type": "object"
    },
    "Mission": {
      "additionalProperties": false,
      "properties": {
        "finish": {
          "default": null,
          "enum": [
            "출발점 복귀",
            "마지막 지점 종료"
          ],
          "title": "Finish",
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/MapSrc",
          "default": null
        },
        "memo": {
          "maxLength": 400,
          "title": "Memo",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "title": "Name",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/PlanStart",
          "default": null
        },
        "tmpl": {
          "maxLength": 40,
          "title": "Tmpl",
          "type": "string"
        },
        "wps": {
          "items": {
            "$ref": "#/$defs/Waypoint"
          },
          "maxItems": 30,
          "title": "Wps",
          "type": "array"
        }
      },
      "required": [
        "name",
        "tmpl",
        "memo",
        "wps"
      ],
      "title": "Mission",
      "type": "object"
    },
    "MissionEnv": {
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "doc": {
          "$ref": "#/$defs/Mission"
        },
        "id": {
          "pattern": "^[a-z][A-Za-z0-9_]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "mission",
          "title": "Kind",
          "type": "string"
        },
        "rev": {
          "minimum": 1,
          "title": "Rev",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rev",
        "by",
        "at",
        "kind",
        "doc"
      ],
      "title": "MissionEnv",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "description": "사진 분류(운영자 관찰, AI 탐지 없음). 같은 photo 에 하나만.",
      "properties": {
        "cls": {
          "enum": [
            "확인",
            "보류",
            "제외"
          ],
          "title": "Cls",
          "type": "string"
        },
        "memo": {
          "maxLength": 400,
          "title": "Memo",
          "type": "string"
        },
        "photo": {
          "pattern": "^media/photos/[0-9]{8}/[A-Za-z0-9_.-]{1,80}\\.jpg$",
          "title": "Photo",
          "type": "string"
        }
      },
      "required": [
        "photo",
        "cls",
        "memo"
      ],
      "title": "Note",
      "type": "object"
    },
    "NoteEnv": {
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "doc": {
          "$ref": "#/$defs/Note"
        },
        "id": {
          "pattern": "^[a-z][A-Za-z0-9_]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "note",
          "title": "Kind",
          "type": "string"
        },
        "rev": {
          "minimum": 1,
          "title": "Rev",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rev",
        "by",
        "at",
        "kind",
        "doc"
      ],
      "title": "NoteEnv",
      "type": "object"
    },
    "PlanStart": {
      "additionalProperties": false,
      "description": "계획 출발점 S(10-19, 선택 키 start — 없음 = 출발점 미지정, null 불가). 사용자가 지도에서 고른 GT 좌표 하나.\nmap = S 를 고른 때의 출처(필수, MapSrc 와 같은 형식) — map.key 는 [S] 한 점의 좌표 지문(UI wkey([S])). 계획 map(지점 출처)과 별개.\n서버는 형식만 검사하고 start ↔ Mission.map 관계는 보지 않는다(UI 몫). 로봇 이동·자동 복귀 수행 아님.",
      "properties": {
        "map": {
          "$ref": "#/$defs/MapSrc"
        },
        "x": {
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "map"
      ],
      "title": "PlanStart",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "수동 임무 진행(운영자 기록 — 로봇 자동 완료 아님). status=진행 은 전체에서 하나만.",
      "properties": {
        "ended": {
          "maxLength": 32,
          "title": "Ended",
          "type": "string"
        },
        "finish": {
          "default": null,
          "enum": [
            "출발점 복귀",
            "마지막 지점 종료"
          ],
          "title": "Finish",
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/MapSrc",
          "default": null
        },
        "mcas": {
          "const": 1,
          "default": null,
          "title": "Mcas",
          "type": "integer"
        },
        "memo": {
          "maxLength": 400,
          "title": "Memo",
          "type": "string"
        },
        "mission": {
          "maxLength": 40,
          "title": "Mission",
          "type": "string"
        },
        "mode": {
          "const": "수동",
          "title": "Mode",
          "type": "string"
        },
        "mrev": {
          "default": null,
          "minimum": 1,
          "title": "Mrev",
          "type": "integer"
        },
        "name": {
          "maxLength": 60,
          "title": "Name",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/PlanStart",
          "default": null
        },
        "started": {
          "maxLength": 32,
          "title": "Started",
          "type": "string"
        },
        "status": {
          "enum": [
            "진행",
            "완료",
            "실패",
            "중단"
          ],
          "title": "Status",
          "type": "string"
        },
        "tmpl": {
          "maxLength": 60,
          "title": "Tmpl",
          "type": "string"
        },
        "wps": {
          "items": {
            "$ref": "#/$defs/RunWaypoint"
          },
          "maxItems": 30,
          "title": "Wps",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "mission",
        "tmpl",
        "name",
        "status",
        "started",
        "ended",
        "memo",
        "wps"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunEnv": {
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "doc": {
          "$ref": "#/$defs/Run"
        },
        "id": {
          "pattern": "^[a-z][A-Za-z0-9_]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "run",
          "title": "Kind",
          "type": "string"
        },
        "rev": {
          "minimum": 1,
