  "$id": "fh-app/1/DocsList",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "GET /api/docs. broken = 저장소 사용 불가 이유(쓰기 503) 또는 null.",
  "properties": {
    "broken": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Broken"
    },
    "docs": {
      "items": {
        "discriminator": {
          "mapping": {
            "mission": "#/$defs/MissionEnv",
            "note": "#/$defs/NoteEnv",
            "run": "#/$defs/RunEnv",
            "tmpl": "#/$defs/TmplEnv",
            "zone": "#/$defs/ZoneEnv"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ZoneEnv"
          },
          {
            "$ref": "#/$defs/TmplEnv"
          },
          {
            "$ref": "#/$defs/MissionEnv"
          },
          {
            "$ref": "#/$defs/RunEnv"
          },
          {
            "$ref": "#/$defs/NoteEnv"
          }
        ]
      },
      "title": "Docs",
      "type": "array"
    },
    "rev": {
      "title": "Rev",
      "type": "integer"
    }
  },
  "required": [
    "docs",
    "rev",
    "broken"
  ],
  "title": "DocsList",
  "type": "object"
}
