    },
    "RunWaypoint": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "maxLength": 32,
          "title": "At",
          "type": "string"
        },
        "chk": {
          "enum": [
            "",
            "확인",
            "보류",
            "제외"
          ],
          "title": "Chk",
          "type": "string"
        },
        "mods": {
          "items": {
            "enum": [
              "사진",
              "운영자 확인",
              "대기"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Mods",
          "type": "array"
        },
        "name": {
          "maxLength": 40,
          "title": "Name",
          "type": "string"
        },
        "photos": {
          "items": {
            "pattern": "^media/photos/[0-9]{8}/[A-Za-z0-9_.-]{1,80}\\.jpg$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Photos",
          "type": "array"
        },
        "st": {
          "enum": [
            "대기",
            "방문",
            "미방문"
          ],
          "title": "St",
          "type": "string"
        },
        "why": {
          "maxLength": 120,
          "title": "Why",
          "type": "string"
        },
        "x": {
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 10000.0,
          "minimum": -10000.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "name",
        "mods",
        "st",
        "at",
        "why",
        "chk",
        "photos"
      ],
      "title": "RunWaypoint",
      "type": "object"
    },
    "Tmpl": {
      "additionalProperties": false,
