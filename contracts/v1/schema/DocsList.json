        "y",
        "name",
        "mods"
      ],
      "title": "Waypoint",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 40,
          "title": "Name",
          "type": "string"
        },
        "pts": {
          "items": {
            "items": {
              "maximum": 10000.0,
              "minimum": -10000.0,
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 40,
          "minItems": 3,
          "title": "Pts",
          "type": "array"
        },
        "type": {
          "enum": [
            "금지",
            "감속"
          ],
