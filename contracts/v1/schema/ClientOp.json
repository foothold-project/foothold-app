{
  "$defs": {
    "OpCmd": {
      "description": "20 Hz. 손 뗌 = 0,0,0. 형식이 틀리면 서버는 거부가 아니라 «명령 0 + 입력 무효화»로 처리한다.",
      "properties": {
        "fw": {
          "maximum": 1,
          "minimum": -1,
          "title": "Fw",
          "type": "number"
        },
        "fx": {
          "maximum": 1,
          "minimum": -1,
          "title": "Fx",
          "type": "number"
        },
        "fy": {
          "maximum": 1,
          "minimum": -1,
          "title": "Fy",
          "type": "number"
        },
        "op": {
          "const": "cmd",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "fx",
        "fy",
        "fw"
      ],
      "title": "OpCmd",
      "type": "object"
    },
    "OpMapGet": {
      "description": "저장 지도 한 장. 이름은 서버 허용목록·정규식으로 다시 검사한다(docs/CONTRACT-maps-sim-stop.md).",
      "properties": {
        "building_id": {
          "enum": [
            "v5",
            "v5_single",
            "rooms_a"
          ],
          "title": "Building Id",
          "type": "string"
        },
        "floor_id": {
          "enum": [
            "f1",
            "l1",
            "l2"
          ],
          "title": "Floor Id",
          "type": "string"
        },
        "map_version": {
          "pattern": "^(\\d{8}-\\d{6}-e\\d+|gt-\\d{8})$",
          "title": "Map Version",
          "type": "string"
        },
        "op": {
          "const": "map_get",
          "title": "Op",
          "type": "string"
        },
        "rid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rid"
        }
      },
      "required": [
        "op",
        "building_id",
        "floor_id",
        "map_version"
      ],
      "title": "OpMapGet",
      "type": "object"
    },
    "OpMapStart": {
      "description": "지도 체험 시작(RL start_map.sh 1회). 허용표·버전 규칙·원장·조종 상태는 서버가 다시 검사한다(docs/CONTRACT-maps-sim-stop.md 8절).",
      "properties": {
        "floor_id": {
          "enum": [
            "f1",
            "l1",
            "l2"
          ],
          "title": "Floor Id",
          "type": "string"
        },
        "map_version": {
          "anyOf": [
            {
              "pattern": "^(\\d{8}-\\d{6}-e\\d+|gt-\\d{8})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Version"
        },
        "mode": {
          "enum": [
            "slam",
            "static"
          ],
          "title": "Mode",
          "type": "string"
        },
        "op": {
          "const": "map_start",
          "title": "Op",
          "type": "string"
        },
        "rid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rid"
        },
        "world_id": {
          "enum": [
            "v5_single",
            "v5_building",
            "rooms_a"
          ],
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "op",
        "world_id",
        "floor_id",
        "mode"
      ],
      "title": "OpMapStart",
      "type": "object"
    },
    "OpRid": {
      "description": "응답(op=reply)이 오는 요청. rid 가 정수가 아니면 서버는 rid=null 로 답한다.",
      "properties": {
        "op": {
          "enum": [
            "photo",
            "sim_start",
            "sim_stop",
            "map_list",
            "map_live_get",
            "map_save"
          ],
          "title": "Op",
          "type": "string"
        },
        "rid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rid"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpRid",
      "type": "object"
    },
    "OpSimple": {
      "properties": {
        "op": {
          "enum": [
            "take",
            "release",
            "stop",
            "resume",
            "reset",
            "hidden"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpSimple",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ClientOp",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "cmd": "#/$defs/OpCmd",
      "hidden": "#/$defs/OpSimple",
      "map_get": "#/$defs/OpMapGet",
      "map_list": "#/$defs/OpRid",
      "map_live_get": "#/$defs/OpRid",
      "map_save": "#/$defs/OpRid",
      "map_start": "#/$defs/OpMapStart",
      "photo": "#/$defs/OpRid",
      "release": "#/$defs/OpSimple",
      "reset": "#/$defs/OpSimple",
      "resume": "#/$defs/OpSimple",
      "sim_start": "#/$defs/OpRid",
      "sim_stop": "#/$defs/OpRid",
      "stop": "#/$defs/OpSimple",
      "take": "#/$defs/OpSimple"
    },
    "propertyName": "op"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/OpSimple"
    },
    {
      "$ref": "#/$defs/OpCmd"
    },
    {
      "$ref": "#/$defs/OpRid"
    },
    {
      "$ref": "#/$defs/OpMapGet"
    },
    {
      "$ref": "#/$defs/OpMapStart"
    }
  ]
}
