{
  "$defs": {
    "OpCmd": {
      "description": "20 Hz. 손 뗌 = 0,0,0. 형식이 틀리면 서버는 거부가 아니라 «명령 0 + 입력 무효화»로 처리한다.",
      "properties": {
        "fw": {
          "maximum": 1,
          "minimum": -1,
          "title": "Fw",
          "type": "number"
        },
        "fx": {
          "maximum": 1,
          "minimum": -1,
          "title": "Fx",
          "type": "number"
        },
        "fy": {
          "maximum": 1,
          "minimum": -1,
          "title": "Fy",
          "type": "number"
        },
        "op": {
          "const": "cmd",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "fx",
        "fy",
        "fw"
      ],
      "title": "OpCmd",
      "type": "object"
    },
    "OpRid": {
      "description": "응답(op=reply)이 오는 요청. rid 가 정수가 아니면 서버는 rid=null 로 답한다.",
      "properties": {
        "op": {
          "enum": [
            "photo",
            "sim_start"
          ],
          "title": "Op",
          "type": "string"
        },
        "rid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rid"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpRid",
      "type": "object"
    },
    "OpSimple": {
      "properties": {
        "op": {
          "enum": [
            "take",
            "release",
            "stop",
            "resume",
            "reset",
            "hidden"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpSimple",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ClientOp",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "cmd": "#/$defs/OpCmd",
      "hidden": "#/$defs/OpSimple",
      "photo": "#/$defs/OpRid",
      "release": "#/$defs/OpSimple",
      "reset": "#/$defs/OpSimple",
      "resume": "#/$defs/OpSimple",
      "sim_start": "#/$defs/OpRid",
      "stop": "#/$defs/OpSimple",
      "take": "#/$defs/OpSimple"
    },
    "propertyName": "op"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/OpSimple"
    },
    {
      "$ref": "#/$defs/OpCmd"
    },
    {
      "$ref": "#/$defs/OpRid"
    }
  ]
}
