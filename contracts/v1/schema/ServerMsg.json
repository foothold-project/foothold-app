  "$id": "fh-app/1/ServerMsg",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "reply": "#/$defs/Reply",
      "status": "#/$defs/Status"
    },
    "propertyName": "op"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Status"
    },
    {
      "$ref": "#/$defs/Reply"
    }
  ]
}
