{
  "$defs": {
    "Event": {
      "properties": {
        "st": {
          "enum": [
            "ok",
            "warn",
            "bad"
          ],
          "title": "St",
          "type": "string"
        },
        "t": {
          "title": "T",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "t",
        "st",
        "text"
      ],
      "title": "Event",
      "type": "object"
    },
    "PhotoMeta": {
      "description": "photos.jsonl 한 줄 = 사진 저장 응답. 위치는 저장 요청 때의 최신 GT(프레임 동기 아님).",
      "properties": {
        "by": {
          "title": "By",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "camera": {
          "title": "Camera",
          "type": "string"
        },
        "episode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Episode"
        },
        "frame_at": {
          "title": "Frame At",
          "type": "string"
        },
        "frame_stamp_sim_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Stamp Sim S"
        },
        "gt_age_s": {
          "title": "Gt Age S",
          "type": "number"
        },
        "gt_note": {
          "title": "Gt Note",
          "type": "string"
        },
        "saved_at": {
          "title": "Saved At",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        },
        "url": {
          "pattern": "^media/photos/[0-9]{8}/[A-Za-z0-9_.-]{1,80}\\.jpg$",
          "title": "Url",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yaw"
        }
      },
      "required": [
        "frame_at",
        "frame_stamp_sim_s",
        "episode",
        "by",
        "source",
        "x",
        "y",
        "yaw",
        "gt_note",
        "gt_age_s",
        "camera",
        "saved_at",
        "bytes",
        "url"
      ],
      "title": "PhotoMeta",
      "type": "object"
    },
    "Reply": {
      "properties": {
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "op": {
          "const": "reply",
          "title": "Op",
          "type": "string"
        },
        "photo": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhotoMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rid"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "op",
        "rid",
        "ok",
        "text"
      ],
      "title": "Reply",
      "type": "object"
    },
    "SimSession": {
      "properties": {
        "ends_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ends At"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "remaining_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remaining S"
        },
        "result": {
          "anyOf": [
            {
              "enum": [
                "running",
                "starting",
                "idle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        }
      },
      "required": [
        "result",
        "reason",
        "started_at",
        "ends_at",
        "remaining_s"
      ],
      "title": "SimSession",
      "type": "object"
    },
    "SimStartState": {
      "properties": {
        "busy": {
          "title": "Busy",
          "type": "boolean"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimSession"
            },
            {
              "type": "null"
            }
          ]
        },
        "why": {
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "why",
        "busy",
        "session"
      ],
      "title": "SimStartState",
      "type": "object"
    },
    "SimState": {
      "description": "status.sim = v2_link clean_state() 결과. 관문값 4개는 항상 형식이 맞다(아니면 sim 자체를 받지 않음).\n나머지는 시뮬이 형식에 맞게 보냈을 때만 값, 아니면 null(=미확인). 키는 항상 모두 있다.",
      "properties": {
        "body_still": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Body Still"
        },
        "camera": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Camera"
        },
        "cmd_age_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cmd Age S"
        },
        "cmd_applied": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cmd Applied"
        },
        "cmd_tested": {
