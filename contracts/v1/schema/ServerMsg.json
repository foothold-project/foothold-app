    "Status": {
      "description": "10 Hz 상태. 안전 판단(latch·applied·reason)의 정본은 서버. role 은 송신 허용에만 쓴다.",
      "properties": {
        "applied": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Applied",
          "type": "array"
        },
        "cam_age": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cam Age"
        },
        "docs_rev": {
          "title": "Docs Rev",
          "type": "integer"
        },
        "episode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Episode"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "maxItems": 6,
          "title": "Events",
          "type": "array"
        },
        "holder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Holder"
        },
        "latch": {
          "title": "Latch",
          "type": "boolean"
        },
        "me": {
          "title": "Me",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "op": {
          "const": "status",
          "title": "Op",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reset_pending": {
          "title": "Reset Pending",
          "type": "boolean"
        },
        "resume_pending": {
          "title": "Resume Pending",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "control",
            "view_other",
            "view"
          ],
          "title": "Role",
          "type": "string"
        },
        "ros_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ros Domain"
        },
        "sim": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimState"
            },
            {
              "type": "null"
            }
          ]
        },
        "sim_block": {
          "title": "Sim Block",
          "type": "string"
        },
        "sim_start": {
          "$ref": "#/$defs/SimStartState"
        },
        "state_age": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Age"
        },
        "ver": {
          "title": "Ver",
          "type": "string"
        }
      },
      "required": [
        "op",
        "role",
        "latch",
        "applied",
        "reason",
        "sim_block",
        "resume_pending",
        "reset_pending",
        "episode",
        "ros_domain",
        "state_age",
        "cam_age",
        "sim",
        "events",
        "note",
        "me",
        "holder",
        "ver",
        "sim_start",
        "docs_rev"
