  "$id": "fh-app/1/Status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "10 Hz 상태. 안전 판단(latch·applied·reason)의 정본은 서버. role 은 송신 허용에만 쓴다.",
  "properties": {
    "applied": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Applied",
      "type": "array"
    },
    "cam_age": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cam Age"
    },
    "docs_rev": {
      "title": "Docs Rev",
      "type": "integer"
    },
    "episode": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Episode"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "maxItems": 6,
      "title": "Events",
      "type": "array"
    },
    "holder": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Holder"
    },
