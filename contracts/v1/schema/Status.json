          "$ref": "#/$defs/SimState"
        },
        {
          "type": "null"
        }
      ]
    },
    "sim_block": {
      "title": "Sim Block",
      "type": "string"
    },
    "sim_start": {
      "$ref": "#/$defs/SimStartState"
    },
    "sim_stop": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimStopState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state_age": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "State Age"
    },
    "ver": {
      "title": "Ver",
      "type": "string"
    }
