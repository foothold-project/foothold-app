      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "reset_pending": {
      "title": "Reset Pending",
      "type": "boolean"
    },
    "resume_pending": {
      "title": "Resume Pending",
      "type": "boolean"
    },
    "role": {
      "enum": [
        "control",
        "view_other",
        "view"
      ],
      "title": "Role",
      "type": "string"
    },
    "ros_domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ros Domain"
    },
    "sim": {
