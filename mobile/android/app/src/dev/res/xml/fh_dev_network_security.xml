<?xml version="1.0" encoding="utf-8"?>
<!-- 평문 금지 + OS 신뢰 저장소만. 사용자 설치 CA(user)·debug-overrides 없음 — 터널(*.trycloudflare.com) 등 서버는 공인 인증서. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
