# 브라우저에서 접속할 호스트 웹 포트다(이미 쓰는 포트면 변경).
FH_WEB_PORT=5180
# 호스트에서 API를 확인할 포트다(컨테이너 안에서는 항상 8810).
FH_API_PORT=8810
# 로컬 DB 초기 관리자 이름이며 API 전용 fh_app과 다르게 둔다.
FH_DB_USER=local_admin
# 이름 있는 DB volume 안에 만들 로컬 데이터베이스 이름이다.
FH_DB_NAME=foothold_local
# 각자 채울 로컬 전용 DB 비밀번호다(비어 있으면 시작 거절).
FH_DB_PASSWORD=
# Compose db의 API 접속 주소이며 비밀번호는 위 값으로 안전하게 주입한다.
FH_DATABASE_URL=postgresql+psycopg://fh_app@db:5432/${FH_DB_NAME}
# 로컬 예시 조직 UUID이며 실제 조직 ID를 복사하지 않는다.
FH_ORG_ID=00000000-0000-4000-8000-000000000001
# 로컬에서 표시할 예시 조직 이름이다.
FH_ORG_NAME='로컬 개발 조직'
# 브라우저 출처이며 웹 포트를 바꾸면 이 값도 같은 포트로 맞춘다.
FH_WS_ORIGIN=http://localhost:${FH_WEB_PORT}
# 컨테이너 안 파일 저장 위치이며 호스트 개인 경로가 아니다.
FH_FILES_ROOT=/var/lib/foothold/files
# 로컬에서는 로봇 연결 프로그램 생성·다운로드를 끈다.
FH_ROBOT_INSTALLER_ENABLED=0
# 최초 생성할 로컬 총괄의 로그인 이름이다.
FH_BOOTSTRAP_USERNAME=local-admin
# 최초 생성할 로컬 총괄의 표시 이름이다.
FH_BOOTSTRAP_DISPLAY_NAME='로컬 총괄'
# 각자 채울 최초 로그인 비밀번호다(비어 있으면 시작 거절).
FH_BOOTSTRAP_PASSWORD=
# FH_SIM_MANAGER_URL·FH_SIM_AUTH_FILE은 로컬에선 끔(설정하지 않음).
# FH_PHONE_PASS_KEYS는 로컬에선 끔(설정하지 않음).
# FH_SERVER_DRIVE_*는 로컬에선 끔(Compose가 실행 권한을 0으로 고정).
