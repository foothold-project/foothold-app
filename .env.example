# 앱 전체가 읽는 환경 변수 이름 목록. 값은 비워 둔다. 실제 값은 저장소 밖에 채운다.
# 로컬 compose 는 deploy/local/.env.example 을 쓴다. 운영 서버는 /etc/foothold/server.env (deploy/server.env.example).
# 시뮬 관리자 운영 값은 deploy/foothold-sim-manager.env.example · deploy/rootfs-manager.env.example 를 본다.
# 표시: [비밀] = 비밀번호 · 토큰 · 키 · 관리자 DSN, [주소] = 내부 주소 · 호스트 · URL · NIC · 포트 목록, [한 번] = 첫 준비 때만.
# 이 파일은 이름 목록이다. 이 파일을 그대로 읽는 프로그램은 없다.

# ---------------------------------------------------------------------------
# 서버 (apps/server)
# ---------------------------------------------------------------------------

# [비밀] [주소] 서버가 앱 역할(fh_app)로 붙는 DB 주소, postgresql+psycopg (읽는 곳: apps/server/fh_server/api.py · sim_maps.py)
FH_DATABASE_URL=
# 이 서버가 맡는 조직 UUID. 없으면 서버가 뜨지 않음 (읽는 곳: apps/server/fh_server/api.py · bootstrap.py · deploy/database.py · deploy/smoke_account.py · deploy/local/init_db.py)
FH_ORG_ID=
# [주소] 브라우저 WebSocket 을 받아 줄 Origin 하나 (읽는 곳: apps/server/fh_server/api.py · deploy/site.py 가 FH_SITE 로 만듦)
FH_WS_ORIGIN=
# 지도 · 기록 같은 파일을 두는 폴더 (읽는 곳: apps/server/fh_server/api.py · apps/server/migrations/versions/0027_sim_pairs.py)
FH_FILES_ROOT=
# 휴대폰 관문 로봇별 키 묶음 파일 경로. 실행 사용자 소유 0600 파일이어야 하고 내용은 비밀 (읽는 곳: apps/server/fh_server/api.py)
FH_PHONE_PASS_KEYS=
# 로봇 설치 파일 내려받기 켜기. 1 이면 켬 (기본 1) (읽는 곳: apps/server/fh_server/api.py)
FH_ROBOT_INSTALLER_ENABLED=
# 서버 경유 조종 전체 스위치. 1 켬 · 0 끔. 있으면 FH_SERVER_DRIVE_ROBOTS 보다 우선 (읽는 곳: apps/server/fh_server/api.py)
FH_SERVER_DRIVE_ENABLED=
# 서버 경유 조종을 허락할 로봇 UUID 쉼표 목록. FH_SERVER_DRIVE_ENABLED 가 없을 때만 읽음 (읽는 곳: apps/server/fh_server/api.py)
FH_SERVER_DRIVE_ROBOTS=
# [주소] 서버가 부르는 Gazebo 시뮬 관리자 주소 (읽는 곳: apps/server/fh_server/api.py)
FH_SIM_MANAGER_URL=
# 시뮬 관리자 인증 값이 든 비공개 파일 경로. 파일 내용은 비밀 (읽는 곳: apps/server/fh_server/api.py · apps/simmgr/config.py · deploy/sim_control.py)
FH_SIM_AUTH_FILE=
# [주소] 시뮬에서 기본 밖에 더 여는 포트 쉼표 목록 (읽는 곳: apps/contracts/simulation_ports.py, 서버 apps/server/fh_server/simulation.py 와 apps/simmgr/config.py 가 씀)
FH_SIM_EXTRA_PORTS=
# 휴대폰 터널 모드 켜기. 1 일 때만 FH_TUNNEL_ORIGIN 을 봄 (읽는 곳: apps/server/fh_server/tunnel.py · apps/agent/foothold_agent/phone/origins.py · apps/web/tunnel.ts · apps/web/vite.config.ts)
FH_TUNNEL=
# [주소] 터널의 정확한 HTTPS 출처. 틀리면 무시하고 경고 (읽는 곳: apps/server/fh_server/tunnel.py · apps/agent/foothold_agent/phone/origins.py · apps/web/tunnel.ts)
FH_TUNNEL_ORIGIN=

# ---------------------------------------------------------------------------
# 서버 첫 준비 (bootstrap · alembic)
# ---------------------------------------------------------------------------

# [비밀] [주소] [한 번] DB 관리자 DSN. 역할 셋을 만들 때만 (읽는 곳: apps/server/fh_server/bootstrap.py · deploy/local/init_db.py)
FH_BOOTSTRAP_DATABASE_DSN=
# [비밀] [주소] 마이그레이션 역할(fh_migrate) DB 주소. alembic 이 배포 때마다 읽음 (읽는 곳: apps/server/migrations/env.py · apps/server/fh_server/bootstrap.py · deploy/database.py 가 만들어 넘김)
FH_MIGRATE_DATABASE_URL=
# [비밀] [한 번] fh_migrate 역할 비밀번호 (읽는 곳: apps/server/fh_server/bootstrap.py · deploy/bootstrap-state.py, 운영은 /etc/foothold/database.env 에서 deploy/database.py · smoke_account.py)
FH_MIGRATE_PASSWORD=
# [비밀] [한 번] fh_app 역할 비밀번호 (읽는 곳: apps/server/fh_server/bootstrap.py · deploy/bootstrap-state.py)
FH_APP_PASSWORD=
# [비밀] [한 번] fh_readonly 역할 비밀번호 (읽는 곳: apps/server/fh_server/bootstrap.py · deploy/bootstrap-state.py)
FH_READONLY_PASSWORD=
# [한 번] 첫 조직 이름 (읽는 곳: apps/server/fh_server/bootstrap.py · deploy/bootstrap-server.sh · deploy/bootstrap-state.py)
FH_ORG_NAME=
# [한 번] 첫 총괄 계정 아이디 (읽는 곳: apps/server/fh_server/bootstrap.py · deploy/bootstrap-server.sh · deploy/bootstrap-state.py)
FH_BOOTSTRAP_USERNAME=
# [한 번] 첫 총괄 계정 표시 이름 (읽는 곳: apps/server/fh_server/bootstrap.py · deploy/bootstrap-server.sh · deploy/bootstrap-state.py)
FH_BOOTSTRAP_DISPLAY_NAME=
# [비밀] [한 번] 첫 총괄 계정 비밀번호. 운영은 deploy/bootstrap-state.py 가 새로 만듦 (읽는 곳: apps/server/fh_server/bootstrap.py)
FH_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# 웹 (apps/web 개발 · 빌드)
# ---------------------------------------------------------------------------

# [주소] Vite 개발 서버가 /api 를 넘길 서버 주소 (읽는 곳: apps/web/vite.config.ts)
FH_API=
# [주소] 휴대폰 관문 포트 범위 시작:끝. 기본 범위의 부분만 허락, 벗어나면 프록시 끔 (읽는 곳: apps/web/vite.config.ts · apps/web/tunnel.ts · apps/web/src/phoneTransport.ts, 빌드 때 박힘)
FH_PHONE_PORT_RANGE=
# [비밀] 개발 스택 도구가 stack.json 대신 쓰는 agent 토큰. 화면에서 새로 만든 로봇 확인용 (읽는 곳: apps/web/tools/dev_stack.py)
FH_AGENT_TOKEN=
# [주소] 이전 화면 ui/ 의 Vite 개발 프록시 대상 링크 주소 (읽는 곳: ui/vite.config.ts)
FH_LINK=

# ---------------------------------------------------------------------------
# 노트북 · Jetson agent (apps/agent)
# ---------------------------------------------------------------------------

# 이 agent 가 맡는 로봇 UUID (읽는 곳: apps/agent/foothold_agent/ros_bridge/config.py · go2_direct/config.py · go2_direct/readonly.py, 시뮬은 apps/simmgr/launcher.py 가 넘김)
FOOTHOLD_ROBOT_ID=
# [주소] agent 가 붙는 서버 WebSocket 주소 (읽는 곳: apps/agent/foothold_agent/link/client.py · ros_bridge/config.py · go2_direct/config.py · go2_direct/readonly.py)
FOOTHOLD_AGENT_WS_URL=
# [비밀] 서버가 로봇을 만들 때 한 번 보여 주는 agent 토큰 (읽는 곳: apps/agent/foothold_agent/link/client.py · ros_bridge/config.py · go2_direct/config.py · go2_direct/readonly.py)
FOOTHOLD_AGENT_TOKEN=
# 카메라 켜기. 1 이면 켬 (읽는 곳: apps/agent/foothold_agent/ros_bridge/__main__.py)
FOOTHOLD_CAMERA_ENABLED=
# 카메라 없이도 미디어 경로 켜기. 1 이면 켬 (읽는 곳: apps/agent/foothold_agent/ros_bridge/__main__.py)
FOOTHOLD_MEDIA_ENABLED=
# 다층 건물 층 묶음 JSON. 비우면 쓰지 않음 (읽는 곳: apps/agent/foothold_agent/ros_bridge/floors.py · apps/simmgr/agent_unit.py)
FOOTHOLD_FLOOR_BINDINGS=
# 실행에 쓸 지도 자산 목록 JSON (읽는 곳: apps/agent/foothold_agent/ros_bridge/__main__.py · run_maps.py)
FOOTHOLD_RUN_MAP_ASSETS_JSON=
# 실행 기록 보낼 편지함 파일 경로. :memory: 는 메모리만 (읽는 곳: apps/agent/foothold_agent/ros_bridge/__main__.py)
FOOTHOLD_RUN_OUTBOX_PATH=
# 실행 일시정지 최대 초 (기본 600) (읽는 곳: apps/agent/foothold_agent/ros_bridge/__main__.py)
FOOTHOLD_RUN_PAUSE_TIMEOUT_S=
# [주소] 시나리오 자료를 받아 올 서버 출처 (읽는 곳: apps/agent/foothold_agent/ros_bridge/__main__.py · apps/simmgr/config.py)
FOOTHOLD_SCENARIO_DATA_ORIGIN=
# 도착 판정에 쓰는 자세 값의 최대 나이 초 (기본 1.0) (읽는 곳: apps/agent/foothold_agent/executor/scenario_run.py · apps/simmgr/config.py)
FH_RUN_ARRIVAL_POSE_MAX_AGE_S=
# mDNS 알림 켜기. 0 또는 1 (기본 1) (읽는 곳: apps/agent/foothold_agent/discovery.py)
FOOTHOLD_MDNS_ENABLED=
# [주소] mDNS 로 알릴 주소. 비우면 듣는 호스트 (읽는 곳: apps/agent/foothold_agent/discovery.py)
FOOTHOLD_MDNS_ADDRESS=
# mDNS 로 알릴 이름 (읽는 곳: apps/agent/foothold_agent/discovery.py)
FOOTHOLD_MDNS_NAME=
# mDNS 로 알릴 기종 (읽는 곳: apps/agent/foothold_agent/discovery.py)
FOOTHOLD_MDNS_MODEL=
# [주소] 휴대폰 관문이 들을 호스트. 휴대폰 변수 하나라도 주면 아래 휴대폰 변수 전부 필요 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_HOST=
# 휴대폰 관문이 들을 포트 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_PORT=
# 휴대폰 관문 키 파일 경로. 파일 내용은 비밀 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_KEY_PATH=
# 휴대폰 관문이 알리는 정책 이름 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_POLICY_NAME=
# 휴대폰 관문이 알리는 정책 판 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_POLICY_VERSION=
# 휴대폰 관문이 받는 조직 UUID (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_ORG_ID=
# 휴대폰 관문 재사용 막기 DB 파일 경로 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_REPLAY_DB=
# 시계 동기화를 확인했을 때만 1. 없거나 다른 값이면 시작 거부 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_CLOCK_TRUSTED=
# 시뮬 여부. 0 또는 1 을 꼭 줌 (읽는 곳: apps/agent/foothold_agent/phone/server.py)
FOOTHOLD_PHONE_SIMULATION=
# [주소] 휴대폰 관문이 받아 줄 앱 서버 출처 JSON 목록 (읽는 곳: apps/agent/foothold_agent/phone/server.py · apps/simmgr/config.py)
FOOTHOLD_PHONE_ORIGINS=
# Go2 직결 어댑터 켜기. 1 일 때만 (읽는 곳: apps/agent/foothold_agent/go2_direct/approval.py · readonly.py)
FH_GO2_DIRECT_ENABLED=
# [주소] Go2 직결에 쓰는 로봇 쪽 NIC 이름 (읽는 곳: apps/agent/foothold_agent/go2_direct/approval.py)
FH_GO2_DIRECT_NIC=
# 현장 승인 표식 JSON 의 절대 경로 (읽는 곳: apps/agent/foothold_agent/go2_direct/approval.py · readonly.py)
FH_GO2_FIELD_APPROVAL=
# 전용 망을 현장에서 확인한 뒤 1 (읽는 곳: apps/agent/foothold_agent/go2_direct/config.py)
FH_GO2_DEDICATED_NIC=
# 서버 경유 시험에서 받아 줄 Go2 상태 번호 쉼표 목록. 승인 JSON 의 accept_error_codes 와 같아야 함 (읽는 곳: apps/agent/foothold_agent/go2_direct/config.py)
FH_GO2_ACCEPT_ERROR_CODES=
# Go2 직결 중 서버로 상태 보고. 0 또는 1 (기본 0) (읽는 곳: apps/agent/foothold_agent/go2_direct/config.py)
FH_GO2_CLOUD_REPORTING=
# 원격 조종 입력 무시 폭 (읽는 곳: apps/agent/foothold_agent/go2_direct/remote.py)
FH_GO2_REMOTE_DEADBAND=
# 원격 조종 입력을 붙잡아 두는 초 (읽는 곳: apps/agent/foothold_agent/go2_direct/remote.py)
FH_GO2_REMOTE_HOLD_S=
# 깊이 영상 ROS 토픽. 화면 선택이 먼저 (읽는 곳: apps/agent/foothold_agent/depth/source.py)
FH_GO2_DEPTH_TOPIC=
# 깊이 최소 미터 (읽는 곳: apps/agent/foothold_agent/depth/source.py)
FH_GO2_DEPTH_MIN_M=
# 깊이 최대 미터 (읽는 곳: apps/agent/foothold_agent/depth/source.py)
FH_GO2_DEPTH_MAX_M=
# 지도 만들기 라이다 ROS 토픽 (읽는 곳: apps/agent/foothold_agent/mapping/runtime.py)
FH_MAPPING_LIDAR_TOPIC=
# 라이다 점의 기준 좌표계 이름 (읽는 곳: apps/agent/foothold_agent/mapping/runtime.py)
FH_MAPPING_LIDAR_FRAME=
# 라이다에서 몸통까지 변환 숫자 여섯 개, 쉼표 구분 (읽는 곳: apps/agent/foothold_agent/mapping/runtime.py)
FH_MAPPING_LIDAR_TO_BODY=
# 지도 만들기 임시 폴더 (읽는 곳: apps/agent/foothold_agent/mapping/runtime.py, 설치기 apps/agent/installer/*.py 가 정해 줌)
FH_MAPPING_CACHE_DIR=
# 주행 기록. 0 이면 끔 (기본 켬) (읽는 곳: apps/agent/foothold_agent/go2_direct/record.py, 설치기는 0 으로 둠)
FH_RECORD=
# 주행 기록 최대 GB (기본 20) (읽는 곳: apps/agent/foothold_agent/go2_direct/record.py)
FH_RECORD_MAX_GB=
# Nav2 실제 기동 허락. 1 일 때만 (읽는 곳: apps/agent/tools/nav2/launch_nav2.py · runner.py, 시뮬은 apps/simmgr/nav2_unit.py 가 넘김)
FH_NAV2_EXECUTE=

# ---------------------------------------------------------------------------
# Gazebo 시뮬 관리자 (apps/simmgr)
# ---------------------------------------------------------------------------

# 진짜 Gazebo · ROS 기동 허락. 1 일 때만 (읽는 곳: apps/simmgr/config.py · launcher.py · sysroot_environment.py · rootfs_environment.py)
FH_SIM_RUN=
# 시뮬 세계 · 자리 목록 JSON 파일 경로 (읽는 곳: apps/simmgr/config.py · deploy/sim_control.py · deploy/rootfs_runtime.py)
FH_SIM_CATALOG=
# [주소] 시뮬 agent 의 휴대폰 관문이 들을 호스트 (읽는 곳: apps/simmgr/config.py)
FH_SIM_AGENT_HOST=
# [주소] 시뮬 agent 가 붙는 서버 WebSocket 주소 (읽는 곳: apps/simmgr/config.py)
FH_SIM_AGENT_WS_URL=
# 시뮬 agent 를 돌릴 python 경로 (읽는 곳: apps/simmgr/config.py · rootfs_environment.py)
FH_SIM_AGENT_PYTHON=
# 시뮬 관리자가 들을 포트 (기본 9430) (읽는 곳: apps/simmgr/config.py)
FH_SIM_PORT=
# 동시에 띄울 시뮬 로봇 수 (기본 2) (읽는 곳: apps/simmgr/config.py)
FH_SIM_MAX_ROBOTS=
# 시뮬 ROS 도메인 번호 (기본 93) (읽는 곳: apps/simmgr/config.py)
FH_SIM_DOMAIN=
# 시뮬 한 번의 최대 초 (기본 1800) (읽는 곳: apps/simmgr/config.py)
FH_SIM_RUNTIME_SECONDS=
# 네이티브 시뮬용 python 부속 폴더. 정해진 한 경로만 허락 (읽는 곳: apps/simmgr/native_vendor.py · environment.py)
FH_SIM_NATIVE_PYTHON_DIR=
# sysroot 실행 프로필. FH_SIM_ROOTFS_LOCK 과 함께 줄 수 없음 (읽는 곳: apps/simmgr/sysroot_environment.py · rootfs_environment.py)
FH_SIM_SYSROOT_PROFILE=
# rootfs 조리법 SHA-256. systemd 유닛이 줌 (읽는 곳: apps/simmgr/rootfs_environment.py · deploy_guard.py · environment.py · deploy/rootfs_probe.py)
FH_SIM_ROOTFS_LOCK=
# 배포 중 시뮬 막기 폴더. systemd 유닛이 줌 (읽는 곳: apps/simmgr/config.py · service.py · sysroot_environment.py · rootfs_environment.py)
FH_SIM_DEPLOY_GUARD_DIR=
# 프로세스 증명 소켓 경로. systemd 유닛이 줌 (읽는 곳: apps/simmgr/config.py · rootfs_environment.py · apps/agent/tools/sim/isolation.py)
FH_SIM_PROC_PROOF_SOCKET=
# 시뮬 원본 폴더 (읽는 곳: apps/simmgr/config.py, 검증 도구 apps/agent/tools/sim/d1.py 도 읽음)
SIM_SOURCE=
# ROS setup 스크립트 경로 (읽는 곳: apps/simmgr/config.py, 검증 도구 apps/agent/tools/sim/d1.py 도 읽음)
SIM_ROS_SETUP=
# 시뮬 실행 기록 폴더 (읽는 곳: apps/simmgr/config.py, 검증 도구 apps/agent/tools/sim/d1.py 도 읽음)
SIM_RUN_DIR=
# agent 자식이 쓸 ROS python 경로. agent_entry.py 가 스스로 만들어 넘김, 손으로 주지 않음 (읽는 곳: apps/simmgr/agent_entry.py)
FH_AGENT_ROS_PATH=

# ---------------------------------------------------------------------------
# 배포 · 빌드 스크립트 (deploy · mobile)
# ---------------------------------------------------------------------------

# [주소] [한 번] 운영 사이트 호스트 이름. Caddy 와 FH_WS_ORIGIN 의 근거 (읽는 곳: deploy/bootstrap-server.sh · deploy/bootstrap-state.py · deploy/Caddyfile · deploy/deploy.sh, 이후 /etc/foothold/site.env)
FH_SITE=
# [한 번] 설치할 Caddy 공식 패키지의 정확한 판 (읽는 곳: deploy/bootstrap-server.sh)
CADDY_VERSION=
# [주소] [한 번] 자동 배포가 받을 GitHub 저장소 주소 (읽는 곳: deploy/bootstrap-autodeploy.sh)
FH_REPO_URL=
# [주소] [한 번] FH_REPO_URL 이 없을 때 대신 쓰는 SSH 저장소 주소 (읽는 곳: deploy/bootstrap-autodeploy.sh)
FH_REPO_SSH_URL=
# [한 번] 설치할 NodeSource 24 LTS apt 판 (읽는 곳: deploy/bootstrap-autodeploy.sh)
NODE_VERSION=
# root 로 빌드할 때 꼭 foothold-build. autodeploy.sh 가 줌 (읽는 곳: deploy/prepare-release.sh)
FH_BUILD_USER=
# auto 면 자동 배포 방식. autodeploy.sh 가 줌 (읽는 곳: deploy/deploy.sh)
FH_DEPLOY_MODE=
# 배포 잠금을 이미 잡았다는 표시. 스크립트끼리 넘김, 손으로 주지 않음 (읽는 곳: deploy/common.sh)
FH_DEPLOY_LOCK_HELD=
# 시뮬 배포 잠금을 이미 잡았다는 표시. 스크립트끼리 넘김, 손으로 주지 않음 (읽는 곳: deploy/common.sh)
FH_SIM_DEPLOY_LOCK_HELD=
# MuJoCo 시뮬 비공개 자산 폴더. 비면 /sim/ 없이 웹만 (읽는 곳: deploy/prepare-release.sh · deploy/local/compose.yaml)
FH_SIM_ASSETS=
# rootfs 점검이 비교할 루트 장치 번호. rootfs_runtime.py 가 넘김 (읽는 곳: deploy/rootfs_probe.py)
FH_SIM_EXPECT_ROOT_DEV=
# rootfs 점검이 비교할 루트 inode 번호. rootfs_runtime.py 가 넘김 (읽는 곳: deploy/rootfs_probe.py)
FH_SIM_EXPECT_ROOT_INO=
# rootfs 점검이 볼 플러그인 경로. rootfs_runtime.py 가 넘김 (읽는 곳: deploy/rootfs_probe.py, 이름을 FH_SIM_PROBE_ + 열쇠로 만듦)
FH_SIM_PROBE_PLUGIN=
# rootfs 점검이 볼 정책 파일 경로. rootfs_runtime.py 가 넘김 (읽는 곳: deploy/rootfs_probe.py)
FH_SIM_PROBE_POLICY=
# 앱 안 오프라인 시뮬 원본 폴더. 모바일 빌드 때 꼭 필요 (읽는 곳: mobile/scripts/sync-web.mjs, mobile/package.json 의 web · apk:dev)
FH_SIM_SRC=
# AME2 정책 ONNX 폴더. 비우면 FH_SIM_SRC (읽는 곳: mobile/scripts/sync-web.mjs)
FH_AME2_SRC=
# AME2 f32 가중치 폴더. 비우면 FH_AME2_SRC (읽는 곳: mobile/scripts/sync-web.mjs)
FH_AME2_F32_SRC=
# 정책 ONNX 폴더. 비우면 FH_SIM_SRC (읽는 곳: mobile/scripts/sync-web.mjs)
FH_POLICY_ONNX_SRC=
# 깊이 쓰는 출발 정책 ONNX 폴더. 비우면 FH_POLICY_ONNX_SRC (읽는 곳: mobile/scripts/sync-web.mjs)
FH_START_SRC=
# 1 이면 ONNX WebGPU 런타임 파일도 넣음 (읽는 곳: mobile/scripts/sync-web.mjs)
FH_POLICY_WEBGPU=
# 1 이면 ONNX WebGPU 런타임 파일도 넣음, AME2 쪽 이름 (읽는 곳: mobile/scripts/sync-web.mjs)
FH_AME2_WEBGPU=

# ---------------------------------------------------------------------------
# 로컬 compose (deploy/local)
# ---------------------------------------------------------------------------

# [비밀] 로컬 postgres 관리자 비밀번호. init 단계에서만 (읽는 곳: deploy/local/compose.yaml)
FH_LOCAL_DB_ADMIN_PASSWORD=
# 브라우저가 여는 로컬 HTTPS 포트 (기본 8443) (읽는 곳: deploy/local/compose.yaml · deploy/local/Caddyfile)
FH_LOCAL_HTTPS_PORT=
# 웹 빌드 컨테이너 안 원본 폴더 (기본 /src) (읽는 곳: deploy/local/build_web.sh)
FH_SRC=
# 웹 빌드 컨테이너 안 작업 폴더 (기본 /work) (읽는 곳: deploy/local/build_web.sh)
FH_WORK=
# 웹 빌드 컨테이너 안 결과 폴더 (기본 /out) (읽는 곳: deploy/local/build_web.sh)
FH_OUT=
# 웹 빌드 컨테이너 안 시뮬 자산 폴더 (기본 /sim-assets) (읽는 곳: deploy/local/build_web.sh)
FH_SIM_ASSETS_DIR=

# 이름만 있고 아직 읽는 곳 없음 (deploy/local/.env.example 의 robot 자리, 미구현): FH_LOCAL_REPLAY_DIR · FH_LOCAL_ROBOT_ADDRESS · FH_LOCAL_ROBOT_NIC
# 환경 변수가 아니라 비공개 env 파일 열쇠로만 읽음 (deploy/smoke_account.py 가 만들고 deploy/smoke.py 가 읽음): FH_SMOKE_USERNAME · FH_SMOKE_PASSWORD
# 시험 · 검증 도구 전용, 이 파일에서 값을 주지 않음: FH_TEST_PORT_RANGE · FH_TEST_DEPTH_WIRE · FH_TEST_STORAGE · FH_TSC · FH_INSTALLER_TEST_CACHE · FH_ALLOW_ARM_DDS · FH_SKIP_PREFLIGHT · FOOTHOLD_RESTART_TEST · FOOTHOLD_ROS_SYNTHETIC · FOOTHOLD_EXTERNAL_CAMERA_ENABLED · FH_REALTIME_MUTATION_REPORT · FH_REVIEW_AGENT_COMMIT · FH_MEASURE_FILE · FH_SIM_D1_RUN · FH_SIM_D1_MOTION · SIM_WORLD_SDF · LIVE_PORT · V2_LINK_MAPS_ROOT · V2_LINK_V5_PGM · mobile/scripts 시험 (FH_CHROME · FH_PLAYWRIGHT · FH_ORT_WEB · FH_AME2_ONNX · FH_POLICY · FH_SIM_MODULE · FH_SIM_BASE · FH_SIM_BUNDLE · FH_FACTORY_XML · FH_CAPTURE_DIR · FH_BT_REPORT_DIR · FH_SCENARIO_BASE · FH_DISMISS_BASE · FH_TOP_BASE · FH_REPLAY_SHOTS · FH_SHOT · FH_SHOTS · FH_SCREENSHOTS · FH_WWW · AME2_EXPORT · AME2_ORT_BACKEND · AME2_ORT_NODE · AME2_TEST_RUNTIME · POLICY_ORT_NODE · CHROME)
# OS · ROS 표준 변수, 이 파일에서 값을 주지 않음: HOME · PATH · PYTHONPATH · DISPLAY · APPDATA · LOCALAPPDATA · XDG_* · ROS_DOMAIN_ID · RMW_IMPLEMENTATION · GZ_PARTITION · FAKEROOTKEY
