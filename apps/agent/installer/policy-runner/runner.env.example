# Jetson: ~/foothold-policy-1122/runner.env 로 복사하고 chmod 600. 비밀값은 없다.
# C++ 실행기 (foothold-policy-cpp.service) 와 Python 실행기 (foothold-policy.service) 가 함께 읽는다.
# 전원을 껐다 켜도 이 값으로 다시 시작한다.
FH_GO2_DIRECT_ENABLED=1
# Go2 본체와 잇는 Jetson 안쪽 선 이름 (ip -br link 로 확인)
FH_GO2_DIRECT_NIC=enP8p1s0
# Python 실행기 인자. 전진 상한 1.2 · 앉기로 멈춤 · 기록 폴더 · 정책 폴더 (m15500 지도 끔)
RUNNER_ARGS=--folder ../policy/start-m15500-app --mode off --nic enP8p1s0 --live --armed-by-remote --trace-dir ../trace --stop-mode sit --fwd-max 1.2 --status 5 --debug-est ../policy/start-m15500-debug-est
