# ~/foothold-policy-1122/runner.env 로 복사 (0600). 전원을 껐다 켜도 이 값으로 다시 시작한다.
# 상한 표 · 감속 1.2 /s 는 코드 (lowlevel.py) 에 들어 있어 따로 적지 않는다.
FH_GO2_DIRECT_ENABLED=1
FH_GO2_DIRECT_NIC=enP8p1s0
RUNNER_ARGS=--folder ../policy/start-m15500-app --mode off --nic enP8p1s0 --live --armed-by-remote --trace-dir ../trace --stop-mode sit --status 5
