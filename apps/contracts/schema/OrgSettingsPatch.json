{
  "$defs": {
    "BusyHour": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ],
          "title": "Day",
          "type": "string"
        },
        "end": {
          "description": "같은 날 start 보다 늦은 HH:MM. 자정을 넘는 구간은 두 줄로 나눈다.",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "End",
          "type": "string"
        },
        "label": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "start": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "day",
        "start",
        "end",
        "label"
      ],
      "title": "BusyHour",
      "type": "object"
    }
  },
  "$id": "fh-app/1/OrgSettingsPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "battery_low_pct": {
      "maximum": 50,
      "minimum": 5,
      "title": "Battery Low Pct",
      "type": "integer"
    },
    "busy_hours": {
      "items": {
        "$ref": "#/$defs/BusyHour"
      },
      "maxItems": 64,
      "title": "Busy Hours",
      "type": "array"
    },
    "clip_retention_days": {
      "title": "Clip Retention Days",
      "type": "integer"
    },
    "deviation_m": {
      "maximum": 5,
      "minimum": 0.5,
      "title": "Deviation M",
      "type": "number"
    },
    "dup_inspect_min": {
      "maximum": 1440,
      "minimum": 30,
      "title": "Dup Inspect Min",
      "type": "integer"
    },
    "lease_request_timeout_s": {
      "maximum": 30,
      "minimum": 5,
      "title": "Lease Request Timeout S",
      "type": "integer"
    },
    "lidar_view_m": {
      "maximum": 30,
      "minimum": 1,
      "title": "Lidar View M",
      "type": "integer"
    },
    "link_loss_wait_s": {
      "maximum": 30,
      "minimum": 0,
      "title": "Link Loss Wait S",
      "type": "integer"
    },
    "model_overrides": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "object"
      },
      "title": "Model Overrides",
      "type": "object"
    },
    "real_max_vx": {
      "maximum": 1.5,
      "minimum": 0,
      "title": "Real Max Vx",
      "type": "number"
    },
    "real_max_vx_back": {
      "maximum": 1.5,
      "minimum": 0,
      "title": "Real Max Vx Back",
      "type": "number"
    },
    "real_max_vy": {
      "maximum": 1.0,
      "minimum": 0,
      "title": "Real Max Vy",
      "type": "number"
    },
    "real_max_wz": {
      "maximum": 2.5,
      "minimum": 0,
      "title": "Real Max Wz",
      "type": "number"
    },
    "real_no_fast_server_drive": {
      "title": "Real No Fast Server Drive",
      "type": "boolean"
    },
    "run_min_battery_pct": {
      "maximum": 90,
      "minimum": 10,
      "title": "Run Min Battery Pct",
      "type": "integer"
    },
    "show_demo_label": {
      "title": "Show Demo Label",
      "type": "boolean"
    },
    "sim_key_vx": {
      "maximum": 1.5,
      "minimum": 0.1,
      "title": "Sim Key Vx",
      "type": "number"
    },
    "sim_max_vx": {
      "maximum": 1.5,
      "minimum": 0.2,
      "title": "Sim Max Vx",
      "type": "number"
    },
    "sim_max_vy": {
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Sim Max Vy",
      "type": "number"
    },
    "sim_max_wz": {
      "maximum": 1.2,
      "minimum": 0.0,
      "title": "Sim Max Wz",
      "type": "number"
    },
    "sim_min_vx": {
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Sim Min Vx",
      "type": "number"
    },
    "sim_runner_vx": {
      "maximum": 1.5,
      "minimum": 0.1,
      "title": "Sim Runner Vx",
      "type": "number"
    },
    "sim_runner_wz": {
      "maximum": 1.0,
      "minimum": 0.1,
      "title": "Sim Runner Wz",
      "type": "number"
    },
    "stick_deadzone": {
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Stick Deadzone",
      "type": "number"
    }
  },
  "title": "OrgSettingsPatch",
  "type": "object"
}
