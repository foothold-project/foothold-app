{
  "$defs": {
    "ScheduleSlot": {
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assignment Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "gait": {
          "anyOf": [
            {
              "enum": [
                "classic",
                "sport",
                "start",
                "ame2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gait"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CONFIRMED",
            "DRAFT",
            "BATTERY_SWAP"
          ],
          "title": "Kind",
          "type": "string"
        },
        "memo": {
          "title": "Memo",
          "type": "string"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scenario Id"
        },
        "scenario_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scenario Version"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "id",
        "robot_id",
        "scenario_id",
        "scenario_version",
        "gait",
        "start",
        "end",
        "kind",
        "assignment_id",
        "memo",
        "created_by",
        "created_at"
      ],
      "title": "ScheduleSlot",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ScheduleDay",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "day": {
      "format": "date",
      "title": "Day",
      "type": "string"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/ScheduleSlot"
      },
      "title": "Slots",
      "type": "array"
    },
    "tz": {
      "title": "Tz",
      "type": "string"
    }
  },
  "required": [
    "day",
    "tz",
    "slots"
  ],
  "title": "ScheduleDay",
  "type": "object"
}
