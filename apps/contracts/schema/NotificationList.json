{
  "$defs": {
    "Notification": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{0,18}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Id"
        },
        "id": {
          "pattern": "^[1-9][0-9]{0,18}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "link": {
          "title": "Link",
          "type": "string"
        },
        "read_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Read At"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "event_id",
        "kind",
        "title",
        "body",
        "link",
        "read_at",
        "created_at"
      ],
      "title": "Notification",
      "type": "object"
    }
  },
  "$id": "fh-app/1/NotificationList",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Notification"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "unread_count": {
      "minimum": 0,
      "title": "Unread Count",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "next_cursor",
    "unread_count"
  ],
  "title": "NotificationList",
  "type": "object"
}
