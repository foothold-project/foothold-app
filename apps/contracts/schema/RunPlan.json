{
  "$defs": {
    "RunGoal": {
      "additionalProperties": false,
      "properties": {
        "idx": {
          "maximum": 199,
          "minimum": 0,
          "title": "Idx",
          "type": "integer"
        },
        "mission_id": {
          "format": "uuid",
          "title": "Mission Id",
          "type": "string"
        },
        "mission_name": {
          "title": "Mission Name",
          "type": "string"
        },
        "mission_version": {
          "minimum": 1,
          "title": "Mission Version",
          "type": "integer"
        },
        "waypoint_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Waypoint Ref"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "idx",
        "waypoint_ref",
        "x",
        "y",
        "yaw",
        "mission_id",
        "mission_version",
        "mission_name"
      ],
      "title": "RunGoal",
      "type": "object"
    },
    "RunSegment": {
      "additionalProperties": false,
      "properties": {
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "goals": {
          "items": {
            "$ref": "#/$defs/RunGoal"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Goals",
          "type": "array"
        },
        "map_version_id": {
          "format": "uuid",
          "title": "Map Version Id",
          "type": "string"
        }
      },
      "required": [
        "floor_id",
        "map_version_id",
        "goals"
      ],
      "title": "RunSegment",
      "type": "object"
    }
  },
  "$id": "fh-app/1/RunPlan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent-verified snapshot, never accepted as a direct run.start body.",
  "properties": {
    "segments": {
      "items": {
        "$ref": "#/$defs/RunSegment"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "segments"
  ],
  "title": "RunPlan",
  "type": "object"
}
