{
  "$id": "fh-app/1/MapConnector",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "STAIRS",
        "ELEVATOR"
      ],
      "title": "Kind",
      "type": "string"
    },
    "pair_floor_id": {
      "format": "uuid",
      "title": "Pair Floor Id",
      "type": "string"
    },
    "x": {
      "title": "X",
      "type": "number"
    },
    "y": {
      "title": "Y",
      "type": "number"
    },
    "yaw": {
      "title": "Yaw",
      "type": "number"
    }
  },
  "required": [
    "id",
    "kind",
    "pair_floor_id",
    "x",
    "y",
    "yaw"
  ],
  "title": "MapConnector",
  "type": "object"
}
