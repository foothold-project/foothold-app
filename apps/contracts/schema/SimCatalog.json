{
  "$defs": {
    "SimWorld": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 200,
          "title": "Description",
          "type": "string"
        },
        "floors": {
          "items": {
            "$ref": "#/$defs/SimWorldFloor"
          },
          "title": "Floors",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "map_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Id"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "SimWorld",
      "type": "object"
    },
    "SimWorldFloor": {
      "additionalProperties": false,
      "properties": {
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "floor_z": {
          "title": "Floor Z",
          "type": "number"
        },
        "map_version_id": {
          "format": "uuid",
          "title": "Map Version Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "floor_id",
        "name",
        "floor_z",
        "map_version_id"
      ],
      "title": "SimWorldFloor",
      "type": "object"
    }
  },
  "$id": "fh-app/1/SimCatalog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "launcher": {
      "enum": [
        "fake",
        "native-single"
      ],
      "title": "Launcher",
      "type": "string"
    },
    "manager_instance_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manager Instance Id"
    },
    "max_robots": {
      "maximum": 2,
      "minimum": 1,
      "title": "Max Robots",
      "type": "integer"
    },
    "slots": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Slots",
      "type": "array"
    },
    "worlds": {
      "items": {
        "$ref": "#/$defs/SimWorld"
      },
      "title": "Worlds",
      "type": "array"
    }
  },
  "required": [
    "worlds",
    "slots",
    "max_robots",
    "launcher",
    "manager_instance_id"
  ],
  "title": "SimCatalog",
  "type": "object"
}
