{
  "$id": "fh-app/1/AgentMedia",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "const": "photo",
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "step": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step"
    },
    "t": {
      "const": "media",
      "title": "T",
      "type": "string"
    },
    "upload_id": {
      "format": "uuid",
      "title": "Upload Id",
      "type": "string"
    }
  },
  "required": [
    "t",
    "kind",
    "upload_id"
  ],
  "title": "AgentMedia",
  "type": "object"
}
