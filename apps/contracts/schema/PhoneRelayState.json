{
  "$defs": {
    "Battery": {
      "additionalProperties": false,
      "properties": {
        "soc": {
          "maximum": 100,
          "minimum": 0,
          "title": "Soc",
          "type": "number"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "soc",
        "updated_at"
      ],
      "title": "Battery",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CAMERA_RGB",
            "CAMERA_DEPTH",
            "LIDAR",
            "BATTERY",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "OK",
            "MISSING",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "state"
      ],
      "title": "Device",
      "type": "object"
    }
  },
  "$id": "fh-app/1/PhoneRelayState",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Display only: never a direct connection, device inventory or capability.",
  "properties": {
    "age_s": {
      "minimum": 0,
      "title": "Age S",
      "type": "number"
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/Battery"
        },
        {
          "type": "null"
        }
      ]
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/Device"
      },
      "title": "Devices",
      "type": "array"
    },
    "source": {
      "const": "PHONE",
      "default": "PHONE",
      "title": "Source",
      "type": "string"
    },
    "speed": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Speed"
    },
    "valid_for_s": {
      "maximum": 3,
      "minimum": 0,
      "title": "Valid For S",
      "type": "number"
    }
  },
  "required": [
    "source",
    "battery",
    "speed",
    "devices",
    "age_s",
    "valid_for_s"
  ],
  "title": "PhoneRelayState",
  "type": "object"
}
