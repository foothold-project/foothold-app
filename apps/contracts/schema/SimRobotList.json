{
  "$defs": {
    "SimCleanupSlot": {
      "additionalProperties": false,
      "properties": {
        "can_recover": {
          "title": "Can Recover",
          "type": "boolean"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        }
      },
      "required": [
        "robot_id",
        "owner_id",
        "generation",
        "can_recover"
      ],
      "title": "SimCleanupSlot",
      "type": "object"
    },
    "SimExpired": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "reason": {
          "const": "time_limit",
          "default": "time_limit",
          "title": "Reason",
          "type": "string"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        }
      },
      "required": [
        "robot_id",
        "owner_id",
        "generation",
        "reason"
      ],
      "title": "SimExpired",
      "type": "object"
    },
    "SimRobot": {
      "additionalProperties": false,
      "properties": {
        "agent_address": {
          "title": "Agent Address",
          "type": "string"
        },
        "command_topic": {
          "title": "Command Topic",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "launcher": {
          "enum": [
            "fake",
            "native-single"
          ],
          "title": "Launcher",
          "type": "string"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        },
        "simulation": {
          "const": true,
          "title": "Simulation",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "STARTING",
            "PREPARED",
            "RUNNING",
            "STOPPING",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        },
        "tf_prefix": {
          "title": "Tf Prefix",
          "type": "string"
        },
        "world_id": {
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "generation",
        "robot_id",
        "owner_id",
        "world_id",
        "simulation",
        "state",
        "agent_address",
        "namespace",
        "tf_prefix",
        "command_topic",
        "launcher",
        "expires_at"
      ],
      "title": "SimRobot",
      "type": "object"
    }
  },
  "$id": "fh-app/1/SimRobotList",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cleanup": {
      "items": {
        "$ref": "#/$defs/SimCleanupSlot"
      },
      "title": "Cleanup",
      "type": "array"
    },
    "expired": {
      "items": {
        "$ref": "#/$defs/SimExpired"
      },
      "title": "Expired",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SimRobot"
      },
      "title": "Items",
      "type": "array"
    },
    "manager_error": {
      "anyOf": [
        {
          "enum": [
            "SIM_DISABLED",
            "SIM_UNAVAILABLE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manager Error"
    }
  },
  "required": [
    "items",
    "expired",
    "cleanup",
    "manager_error"
  ],
  "title": "SimRobotList",
  "type": "object"
}
