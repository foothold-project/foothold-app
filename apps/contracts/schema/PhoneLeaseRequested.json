{
  "$defs": {
    "PhoneRequester": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "format": "uuid",
          "title": "Device Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "device_id"
      ],
      "title": "PhoneRequester",
      "type": "object"
    }
  },
  "$id": "fh-app/1/PhoneLeaseRequested",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "requester": {
      "$ref": "#/$defs/PhoneRequester"
    },
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "t": {
      "const": "lease.requested",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "robot",
    "request_id",
    "requester",
    "expires_at"
  ],
  "title": "PhoneLeaseRequested",
  "type": "object"
}
