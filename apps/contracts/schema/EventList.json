{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "category": {
          "enum": [
            "RUN",
            "ROUTE",
            "LINK",
            "LEASE",
            "APPROVAL",
            "SAFETY",
            "ACCOUNT"
          ],
          "title": "Category",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "id": {
          "pattern": "^[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "robot_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Robot At"
        },
        "robot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Robot Id"
        },
        "run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARN",
            "ERROR"
          ],
          "title": "Severity",
          "type": "string"
        },
        "user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Id"
        }
      },
      "required": [
        "id",
        "at",
        "robot_at",
        "category",
        "code",
        "severity",
        "message",
        "robot_id",
        "user_id",
        "run_id",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventCategoryCounts": {
      "additionalProperties": false,
      "properties": {
        "ACCOUNT": {
          "minimum": 0,
          "title": "Account",
          "type": "integer"
        },
        "APPROVAL": {
          "minimum": 0,
          "title": "Approval",
          "type": "integer"
        },
        "LEASE": {
          "minimum": 0,
          "title": "Lease",
          "type": "integer"
        },
        "LINK": {
          "minimum": 0,
          "title": "Link",
          "type": "integer"
        },
        "ROUTE": {
          "minimum": 0,
          "title": "Route",
          "type": "integer"
        },
        "RUN": {
          "minimum": 0,
          "title": "Run",
          "type": "integer"
        },
        "SAFETY": {
          "minimum": 0,
          "title": "Safety",
          "type": "integer"
        }
      },
      "required": [
        "RUN",
        "ROUTE",
        "LINK",
        "LEASE",
        "APPROVAL",
        "SAFETY",
        "ACCOUNT"
      ],
      "title": "EventCategoryCounts",
      "type": "object"
    },
    "EventClipCounts": {
      "additionalProperties": false,
      "properties": {
        "with_clip": {
          "description": "data.clip 이 true 인 사건",
          "minimum": 0,
          "title": "With Clip",
          "type": "integer"
        },
        "without_clip": {
          "minimum": 0,
          "title": "Without Clip",
          "type": "integer"
        }
      },
      "required": [
        "with_clip",
        "without_clip"
      ],
      "title": "EventClipCounts",
      "type": "object"
    },
    "EventCounts": {
      "additionalProperties": false,
      "description": "Facet counts for the records filter panel (#613). Each facet applies every\nfilter except its own, so picking one category still shows the others' counts.",
      "properties": {
        "category": {
          "$ref": "#/$defs/EventCategoryCounts"
        },
        "clip": {
          "$ref": "#/$defs/EventClipCounts"
        },
        "severity": {
          "$ref": "#/$defs/EventSeverityCounts"
        },
        "simulation": {
          "$ref": "#/$defs/EventSimulationCounts"
        },
        "total": {
          "description": "모든 거르기를 건 사건 수 (cursor · limit 무시)",
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "category",
        "severity",
        "simulation",
        "clip"
      ],
      "title": "EventCounts",
      "type": "object"
    },
    "EventSeverityCounts": {
      "additionalProperties": false,
      "properties": {
        "ERROR": {
          "minimum": 0,
          "title": "Error",
          "type": "integer"
        },
        "INFO": {
          "minimum": 0,
          "title": "Info",
          "type": "integer"
        },
        "WARN": {
          "minimum": 0,
          "title": "Warn",
          "type": "integer"
        }
      },
      "required": [
        "INFO",
        "WARN",
        "ERROR"
      ],
      "title": "EventSeverityCounts",
      "type": "object"
    },
    "EventSimulationCounts": {
      "additionalProperties": false,
      "properties": {
        "none": {
          "description": "로봇 없는 사건 (계정 등). simulation 을 걸면 목록에서 빠진다",
          "minimum": 0,
          "title": "None",
          "type": "integer"
        },
        "real": {
          "minimum": 0,
          "title": "Real",
          "type": "integer"
        },
        "sim": {
          "minimum": 0,
          "title": "Sim",
          "type": "integer"
        }
      },
      "required": [
        "real",
        "sim",
        "none"
      ],
      "title": "EventSimulationCounts",
      "type": "object"
    }
  },
  "$id": "fh-app/1/EventList",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clip_retention_days": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "사건 영상 보관 일수. 서버 설정 FH_CLIP_RETENTION_DAYS, 없으면 null",
      "title": "Clip Retention Days"
    },
    "counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventCounts"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "첫 쪽 (cursor 없음) 에만 값. 다음 쪽은 null"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "title": "EventList",
  "type": "object"
}
