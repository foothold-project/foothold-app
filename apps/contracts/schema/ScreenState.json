{
  "$defs": {
    "Battery": {
      "additionalProperties": false,
      "properties": {
        "soc": {
          "maximum": 100,
          "minimum": 0,
          "title": "Soc",
          "type": "number"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "soc",
        "updated_at"
      ],
      "title": "Battery",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CAMERA_RGB",
            "CAMERA_DEPTH",
            "LIDAR",
            "BATTERY",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "OK",
            "MISSING",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "state"
      ],
      "title": "Device",
      "type": "object"
    },
    "FloorContext": {
      "additionalProperties": false,
      "description": "Observation identity; compare the entire token before using asynchronous map results.\n\nThis context never grants control or changes STOP/deadman gates. Positions are\nabsent during transit/unknown and when the approved grid binding is invalid.",
      "properties": {
        "building_id": {
          "format": "uuid",
          "title": "Building Id",
          "type": "string"
        },
        "confirmed_sim_t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed Sim T"
        },
        "current_floor_id": {
          "anyOf": [
            {
              "enum": [
                "l1",
                "l2",
                "f1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Floor Id"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "floor_rev": {
          "minimum": 0,
          "title": "Floor Rev",
          "type": "integer"
        },
        "floor_state": {
          "enum": [
            "on_floor",
            "transit",
            "unknown"
          ],
          "title": "Floor State",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Version Id"
        },
        "reason": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "source": {
          "const": "gt_geometry",
          "title": "Source",
          "type": "string"
        },
        "source_pgm_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Pgm Sha256"
        },
        "spawn_floor_id": {
          "enum": [
            "l1",
            "l2",
            "f1"
          ],
          "title": "Spawn Floor Id",
          "type": "string"
        },
        "world_id": {
          "enum": [
            "v5_building",
            "warehouse"
          ],
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "robot_id",
        "generation",
        "run_id",
        "epoch",
        "floor_rev",
        "world_id",
        "building_id",
        "spawn_floor_id",
        "current_floor_id",
        "floor_id",
        "map_version_id",
        "sha256",
        "source_pgm_sha256",
        "source",
        "floor_state",
        "reason",
        "confirmed_sim_t"
      ],
      "title": "FloorContext",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "floor_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/FloorContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Version Id"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yaw"
        }
      },
      "required": [
        "floor_id",
        "map_version_id",
        "x",
        "y",
        "yaw",
        "confidence",
        "updated_at"
      ],
      "title": "Location",
      "type": "object"
    },
    "PhoneRelayState": {
      "additionalProperties": false,
      "description": "Display only: never a direct connection, device inventory or capability.",
      "properties": {
        "age_s": {
          "minimum": 0,
          "title": "Age S",
          "type": "number"
        },
        "battery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Battery"
            },
            {
              "type": "null"
            }
          ]
        },
        "devices": {
          "items": {
            "$ref": "#/$defs/Device"
          },
          "title": "Devices",
          "type": "array"
        },
        "source": {
          "const": "PHONE",
          "default": "PHONE",
          "title": "Source",
          "type": "string"
        },
        "speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Speed"
        },
        "valid_for_s": {
          "maximum": 3,
          "minimum": 0,
          "title": "Valid For S",
          "type": "number"
        }
      },
      "required": [
        "source",
        "battery",
        "speed",
        "devices",
        "age_s",
        "valid_for_s"
      ],
      "title": "PhoneRelayState",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ScreenState",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Applied"
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/Battery"
        },
        {
          "type": "null"
        }
      ]
    },
    "connection": {
      "enum": [
        "ONLINE",
        "OFFLINE"
      ],
      "title": "Connection",
      "type": "string"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/Device"
      },
      "title": "Devices",
      "type": "array"
    },
    "latched": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latched"
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latency Ms"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ]
    },
    "phone_relay": {
      "anyOf": [
        {
          "$ref": "#/$defs/PhoneRelayState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "safety_reason": {
      "anyOf": [
        {
          "const": "OUTPUT_STALLED",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safety Reason"
    },
    "speed": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Speed"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "IDLE",
            "TELEOP",
            "RUNNING",
            "PAUSED",
            "STOP_LATCHED",
            "ERROR"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Status"
    },
    "stop_gen": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stop Gen"
    },
    "t": {
      "const": "state",
      "default": "state",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "robot",
    "connection",
    "status",
    "battery",
    "location",
    "devices",
    "speed",
    "latency_ms",
    "latched",
    "stop_gen",
    "applied"
  ],
  "title": "ScreenState",
  "type": "object"
}
