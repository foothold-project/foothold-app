{
  "$defs": {
    "JsonValue": {},
    "MissionStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "PHOTO",
            "WAIT",
            "OPERATOR_CONFIRM",
            "SENSOR_LOG"
          ],
          "title": "Action",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action"
      ],
      "title": "MissionStep",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ExecutableAgentScenarioWaypoint",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "floor_id": {
      "format": "uuid",
      "title": "Floor Id",
      "type": "string"
    },
    "map_version_id": {
      "format": "uuid",
      "title": "Map Version Id",
      "type": "string"
    },
    "mission_id": {
      "format": "uuid",
      "title": "Mission Id",
      "type": "string"
    },
    "mission_name": {
      "title": "Mission Name",
      "type": "string"
    },
    "mission_steps": {
      "items": {
        "$ref": "#/$defs/MissionStep"
      },
      "maxItems": 100,
      "title": "Mission Steps",
      "type": "array"
    },
    "mission_version": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Mission Version",
      "type": "integer"
    },
    "required_capabilities": {
      "items": {
        "enum": [
          "wait",
          "photo.rgb",
          "photo.depth",
          "operator_confirm",
          "sensor_log.rgb",
          "sensor_log.depth",
          "sensor_log.lidar",
          "sensor_log.battery"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "title": "Required Capabilities",
      "type": "array"
    },
    "waypoint_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waypoint Ref"
    },
    "x": {
      "title": "X",
      "type": "number"
    },
    "y": {
      "title": "Y",
      "type": "number"
    },
    "yaw": {
      "default": 0,
      "title": "Yaw",
      "type": "number"
    }
  },
  "required": [
    "floor_id",
    "map_version_id",
    "x",
    "y",
    "mission_id",
    "mission_version",
    "mission_name",
    "mission_steps",
    "required_capabilities"
  ],
  "title": "ExecutableAgentScenarioWaypoint",
  "type": "object"
}
