{
  "$id": "fh-app/1/ScreenCmd",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "axes": {
      "anyOf": [
        {
          "items": {
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        {
          "enum": [
            [
              -1.5,
              0.0,
              0.0
            ],
            [
              0.0,
              -1.5,
              0.0
            ],
            [
              0.0,
              1.5,
              0.0
            ],
            [
              1.5,
              0.0,
              -0.5
            ],
            [
              1.5,
              0.0,
              0.0
            ],
            [
              1.5,
              0.0,
              0.5
            ]
          ],
          "type": "array"
        }
      ],
      "items": {
        "maximum": 1.5,
        "minimum": -1.5,
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Axes",
      "type": "array"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "proto": {
      "const": "fh-rt/1",
      "description": "첫 메시지는 필수, 후속은 생략 가능; null은 거부한다.",
      "title": "Proto",
      "type": "string"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "t": {
      "const": "cmd",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot",
    "t",
    "lease_id",
    "seq",
    "axes"
  ],
  "title": "ScreenCmd",
  "type": "object"
}
