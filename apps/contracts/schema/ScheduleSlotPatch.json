{
  "$id": "fh-app/1/ScheduleSlotPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "busy_label": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Busy Label"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "gait": {
      "enum": [
        "classic",
        "sport",
        "start",
        "ame2"
      ],
      "title": "Gait",
      "type": "string"
    },
    "kind": {
      "enum": [
        "CONFIRMED",
        "DRAFT",
        "BATTERY_SWAP",
        "MAINTENANCE"
      ],
      "title": "Kind",
      "type": "string"
    },
    "robot_id": {
      "format": "uuid",
      "title": "Robot Id",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    }
  },
  "title": "ScheduleSlotPatch",
  "type": "object"
}
