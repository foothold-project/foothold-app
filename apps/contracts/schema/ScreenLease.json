{
  "$id": "fh-app/1/ScreenLease",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "proto": {
      "anyOf": [
        {
          "const": "fh-rt/1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proto"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "t": {
      "enum": [
        "lease.take",
        "lease.request",
        "lease.release",
        "hidden",
        "stop"
      ],
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot",
    "t"
  ],
  "title": "ScreenLease",
  "type": "object"
}
