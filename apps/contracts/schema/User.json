{
  "$id": "fh-app/1/User",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "locked": {
      "title": "Locked",
      "type": "boolean"
    },
    "robot_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Robot Ids",
      "type": "array"
    },
    "role": {
      "enum": [
        "ORG_ADMIN",
        "OPERATOR"
      ],
      "title": "Role",
      "type": "string"
    },
    "username": {
      "title": "Username",
      "type": "string"
    }
  },
  "required": [
    "id",
    "username",
    "display_name",
    "role",
    "locked",
    "robot_ids",
    "created_at"
  ],
  "title": "User",
  "type": "object"
}
