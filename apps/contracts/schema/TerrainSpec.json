          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "H",
          "type": "number"
        },
        "kind": {
          "const": "box",
          "title": "Kind",
          "type": "string"
        },
        "sx": {
          "exclusiveMinimum": 0,
          "title": "Sx",
          "type": "number"
        },
        "sy": {
          "exclusiveMinimum": 0,
          "title": "Sy",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw",
        "kind",
        "sx",
        "sy",
        "h"
      ],
      "title": "TerrainBox",
      "type": "object"
    },
    "TerrainGap": {
      "additionalProperties": false,
      "properties": {
