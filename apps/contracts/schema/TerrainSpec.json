        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw",
        "kind",
        "length",
        "width"
      ],
      "title": "TerrainGap",
      "type": "object"
    },
    "TerrainRamp": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "H",
          "type": "number"
        },
        "kind": {
          "const": "ramp",
          "title": "Kind",
          "type": "string"
        },
        "length": {
          "exclusiveMinimum": 0,
