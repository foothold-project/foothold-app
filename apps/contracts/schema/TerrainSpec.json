      ],
      "title": "TerrainRamp",
      "type": "object"
    },
    "TerrainStairs": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stairs",
          "title": "Kind",
          "type": "string"
        },
        "rise": {
          "maximum": 0.25,
          "minimum": 0.02,
          "title": "Rise",
          "type": "number"
        },
        "run": {
          "minimum": 0.15,
          "title": "Run",
          "type": "number"
        },
        "steps": {
          "maximum": 50,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
