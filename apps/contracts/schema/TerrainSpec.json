  "$id": "fh-app/1/TerrainSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z0-9-]{1,32}$",
      "title": "Id",
      "type": "string"
    },
    "items": {
      "items": {
        "discriminator": {
          "mapping": {
            "box": "#/$defs/TerrainBox",
            "gap": "#/$defs/TerrainGap",
            "ramp": "#/$defs/TerrainRamp",
            "stairs": "#/$defs/TerrainStairs"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TerrainBox"
          },
          {
            "$ref": "#/$defs/TerrainStairs"
          },
          {
            "$ref": "#/$defs/TerrainRamp"
          },
          {
            "$ref": "#/$defs/TerrainGap"
          }
        ]
      },
      "maxItems": 60,
      "title": "Items",
      "type": "array"
    },
    "name": {
      "maxLength": 40,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "schema": {
      "const": "fh_custom_terrain/1",
      "title": "Schema",
      "type": "string"
    },
    "size": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 30,
          "minimum": 4,
          "type": "number"
        },
        {
          "maximum": 30,
          "minimum": 4,
          "type": "number"
        }
      ],
      "title": "Size",
      "type": "array"
    },
    "spawn": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Spawn",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "size",
    "spawn",
    "items"
  ],
  "title": "TerrainSpec",
  "type": "object"
}
