            {
              "type": "null"
            }
          ],
          "title": "Approved Version Id"
        },
        "building_id": {
          "format": "uuid",
          "title": "Building Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "name": {
          "title": "Name",
