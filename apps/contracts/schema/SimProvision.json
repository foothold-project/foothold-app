{
  "$id": "fh-app/1/SimProvision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_token": {
      "maxLength": 256,
      "minLength": 32,
      "title": "Agent Token",
      "type": "string"
    },
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "org_id": {
      "format": "uuid",
      "title": "Org Id",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "robot_id": {
      "format": "uuid",
      "title": "Robot Id",
      "type": "string"
    },
    "world_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "world_id",
    "robot_id",
    "generation",
    "owner_id",
    "org_id",
    "agent_token"
  ],
  "title": "SimProvision",
  "type": "object"
}
