{
  "$id": "fh-app/1/PhoneLeaseResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "result": {
      "enum": [
        "ACCEPTED",
        "DECLINED",
        "TIMEOUT",
        "CANCELED"
      ],
      "title": "Result",
      "type": "string"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "t": {
      "const": "lease.result",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "robot",
    "request_id",
    "result",
    "error"
  ],
  "title": "PhoneLeaseResult",
  "type": "object"
}
