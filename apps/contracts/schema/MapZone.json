{
  "$id": "fh-app/1/MapZone",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "NO_GO"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "max_speed_mps"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "AREA"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "max_speed_mps"
          ]
        }
      }
    }
  ],
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "max_speed_mps": {
      "anyOf": [
        {
          "maximum": 1.5,
          "minimum": 0.3,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Speed Mps"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "polygon": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "maxItems": 256,
      "minItems": 3,
      "title": "Polygon",
      "type": "array"
    },
    "type": {
      "enum": [
        "NO_GO",
        "SLOW",
        "AREA"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "polygon"
  ],
  "title": "MapZone",
  "type": "object"
}
