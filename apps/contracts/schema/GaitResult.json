{
  "$id": "fh-app/1/GaitResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 64,
      "title": "Code",
      "type": "string"
    },
    "gait": {
      "enum": [
        "classic",
        "sport",
        "start",
        "ame2"
      ],
      "title": "Gait",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "sdk_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sdk Code"
    },
    "status": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "REJECTED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "gait",
    "status",
    "code",
    "sdk_code"
  ],
  "title": "GaitResult",
  "type": "object"
}
