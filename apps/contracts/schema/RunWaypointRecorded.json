{
  "$defs": {
    "AgentPose": {
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "floor_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/FloorContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Version Id"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yaw"
        }
      },
      "required": [
        "floor_id",
        "x",
        "y",
        "yaw",
        "confidence"
      ],
      "title": "AgentPose",
      "type": "object"
    },
    "FloorContext": {
      "additionalProperties": false,
      "description": "Observation identity; compare the entire token before using asynchronous map results.\n\nThis context never grants control or changes STOP/deadman gates. Positions are\nabsent during transit/unknown and when the approved grid binding is invalid.",
      "properties": {
        "building_id": {
          "format": "uuid",
          "title": "Building Id",
          "type": "string"
        },
        "confirmed_sim_t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed Sim T"
        },
        "current_floor_id": {
          "anyOf": [
            {
              "enum": [
                "l1",
                "l2",
                "f1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Floor Id"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "floor_rev": {
          "minimum": 0,
          "title": "Floor Rev",
          "type": "integer"
        },
        "floor_state": {
          "enum": [
            "on_floor",
            "transit",
            "unknown"
          ],
          "title": "Floor State",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Version Id"
        },
        "reason": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "source": {
          "const": "gt_geometry",
          "title": "Source",
          "type": "string"
        },
        "source_pgm_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Pgm Sha256"
        },
        "spawn_floor_id": {
          "enum": [
            "l1",
            "l2",
            "f1"
          ],
          "title": "Spawn Floor Id",
          "type": "string"
        },
        "world_id": {
          "enum": [
            "v5_building",
            "warehouse",
            "rubble"
          ],
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "robot_id",
        "generation",
        "run_id",
        "epoch",
        "floor_rev",
        "world_id",
        "building_id",
        "spawn_floor_id",
        "current_floor_id",
        "floor_id",
        "map_version_id",
        "sha256",
        "source_pgm_sha256",
        "source",
        "floor_state",
        "reason",
        "confirmed_sim_t"
      ],
      "title": "FloorContext",
      "type": "object"
    },
    "RunDisplayResults": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "DISPLAY_ONLY",
          "default": "DISPLAY_ONLY",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "RunDisplayResults",
      "type": "object"
    },
    "RunExecutedResults": {
      "additionalProperties": false,
      "properties": {
        "execution_capability_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Execution Capability Revision",
          "type": "integer"
        },
        "mode": {
          "const": "EXECUTED",
          "title": "Mode",
          "type": "string"
        },
        "run_contract": {
          "const": "scenario/2",
          "title": "Run Contract",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/RunStepResult"
          },
          "maxItems": 100,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "run_contract",
        "execution_capability_revision",
        "steps"
      ],
      "title": "RunExecutedResults",
      "type": "object"
    },
    "RunPhotoReference": {
      "additionalProperties": false,
      "description": "Only server-committed JPEG references; never image bytes or arbitrary URLs.",
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "photo_id": {
          "format": "uuid",
          "title": "Photo Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "const": "rgb",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "photo_id",
        "source",
        "captured_at",
        "sha256"
      ],
      "title": "RunPhotoReference",
      "type": "object"
    },
    "RunStepResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "PHOTO",
            "WAIT",
            "OPERATOR_CONFIRM",
            "SENSOR_LOG"
          ],
          "title": "Action",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "enum": [
                "UNSUPPORTED",
                "CAPABILITY_CHANGED",
                "DEVICE_UNAVAILABLE",
                "NO_FRESH_FRAME",
                "CAPTURE_TIMEOUT",
                "UPLOAD_FAILED",
                "STORAGE_UNAVAILABLE",
                "INTERRUPTED",
                "ACTION_FAILED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        },
        "failure_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Reason"
        },
        "photo": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunPhotoReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "rgb",
                "depth",
                "lidar",
                "battery"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_idx": {
          "maximum": 99,
          "minimum": 0,
          "title": "Step Idx",
          "type": "integer"
        }
      },
      "required": [
        "step_idx",
        "action",
        "source",
        "status",
        "failure_code",
        "failure_reason",
        "photo"
      ],
      "title": "RunStepResult",
      "type": "object"
    }
  },
  "$id": "fh-app/1/RunWaypointRecorded",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_instance_id": {
      "format": "uuid",
      "title": "Agent Instance Id",
      "type": "string"
    },
    "floor_id": {
      "format": "uuid",
      "title": "Floor Id",
      "type": "string"
    },
    "idx": {
      "maximum": 199,
      "minimum": 0,
      "title": "Idx",
      "type": "integer"
    },
    "map_version_id": {
      "format": "uuid",
      "title": "Map Version Id",
      "type": "string"
    },
    "mission_id": {
      "format": "uuid",
      "title": "Mission Id",
      "type": "string"
    },
    "mission_name": {
      "title": "Mission Name",
      "type": "string"
    },
    "mission_version": {
      "minimum": 1,
      "title": "Mission Version",
      "type": "integer"
    },
    "monotonic_s": {
      "minimum": 0,
      "title": "Monotonic S",
      "type": "number"
    },
    "pose": {
      "$ref": "#/$defs/AgentPose"
    },
    "report_seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Report Seq",
      "type": "integer"
    },
    "results": {
      "discriminator": {
        "mapping": {
          "DISPLAY_ONLY": "#/$defs/RunDisplayResults",
          "EXECUTED": "#/$defs/RunExecutedResults"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RunDisplayResults"
        },
        {
          "$ref": "#/$defs/RunExecutedResults"
        }
      ],
      "title": "Results"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "waypoint_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Waypoint Ref"
    }
  },
  "required": [
    "run_id",
    "idx",
    "waypoint_ref",
    "mission_id",
    "mission_version",
    "mission_name",
    "floor_id",
    "map_version_id",
    "pose",
    "agent_instance_id",
    "report_seq",
    "monotonic_s",
    "results"
  ],
  "title": "RunWaypointRecorded",
  "type": "object"
}
