{
  "$id": "fh-app/1/SlamPointCloudHeader",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_length": {
      "maximum": 48000,
      "minimum": 12,
      "title": "Byte Length",
      "type": "integer"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "channel": {
      "const": "slam",
      "title": "Channel",
      "type": "string"
    },
    "count": {
      "maximum": 4000,
      "minimum": 1,
      "title": "Count",
      "type": "integer"
    },
    "encoding": {
      "const": "xyz_f32le",
      "title": "Encoding",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "null"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "frame": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_/-]+$",
      "title": "Frame",
      "type": "string"
    },
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "source": {
      "const": "rt/uslam/frontend/cloud_world_ds",
      "title": "Source",
      "type": "string"
    },
    "t": {
      "const": "media.slam_points",
      "title": "T",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "version": {
      "const": "media/1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "robot",
    "epoch",
    "episode_id",
    "version",
    "captured_at",
    "seq",
    "frame",
    "t",
    "channel",
    "source",
    "count",
    "truncated",
    "encoding",
    "byte_length"
  ],
  "title": "SlamPointCloudHeader",
  "type": "object"
}
