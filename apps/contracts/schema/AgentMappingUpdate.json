          "maxItems": 4000000,
          "title": "Cells",
          "type": "array"
        },
        "floor_z": {
          "title": "Floor Z",
          "type": "number"
        },
        "frame_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "height": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "origin": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "resolution": {
          "const": 0.05,
          "default": 0.05,
          "title": "Resolution",
          "type": "number"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "width": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "frame_id",
        "origin",
        "floor_z",
        "width",
        "height",
        "cells"
      ],
      "title": "MappingGrid",
      "type": "object"
    },
    "MappingGridTile": {
      "additionalProperties": false,
      "description": "64x64 world-aligned cells, lower left at (x*3.2,y*3.2).",
      "properties": {
        "cells": {
          "items": {
            "enum": [
              0,
              1,
              2
            ],
            "type": "integer"
          },
          "maxItems": 4096,
          "minItems": 4096,
          "title": "Cells",
          "type": "array"
        },
        "floor_z": {
          "title": "Floor Z",
          "type": "number"
        },
        "frame_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "resolution": {
          "const": 0.05,
          "default": 0.05,
          "title": "Resolution",
          "type": "number"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "size": {
          "const": 64,
          "default": 64,
          "title": "Size",
          "type": "integer"
        },
        "tile_seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Tile Seq",
          "type": "integer"
        },
        "x": {
          "maximum": 3124,
          "minimum": -3125,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 3124,
          "minimum": -3125,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "tile_seq",
        "x",
        "y",
        "frame_id",
        "floor_z",
        "cells"
      ],
      "title": "MappingGridTile",
      "type": "object"
    },
    "MappingOdom": {
      "additionalProperties": false,
      "properties": {
        "display_stamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Stamp"
        },
        "frame_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "provider": {
          "default": "point_lio",
          "enum": [
            "point_lio",
            "glim"
          ],
          "title": "Provider",
          "type": "string"
        },
        "source": {
          "default": "/aft_mapped_to_init",
          "maxLength": 160,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "stamp": {
          "$ref": "#/$defs/MappingStamp"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "frame_id",
        "stamp",
        "x",
        "y",
        "z",
        "yaw"
      ],
      "title": "MappingOdom",
      "type": "object"
    },
    "MappingPointLioStatus": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active"
        },
        "cloud_age_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cloud Age S"
        },
        "cloud_hz": {
          "description": "Cloud callbacks received in the preceding 1 second, capped at 4096.",
          "maximum": 4096,
          "minimum": 0,
          "title": "Cloud Hz",
          "type": "number"
        },
        "fresh": {
          "title": "Fresh",
          "type": "boolean"
        },
        "pose_age_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pose Age S"
        },
        "pose_hz": {
          "description": "Pose callbacks received in the preceding 1 second, capped at 4096.",
          "maximum": 4096,
          "minimum": 0,
          "title": "Pose Hz",
          "type": "number"
        },
        "position_m": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native Point-LIO origin x/y/z in metres, rounded to 2 decimals; may include rejected finite coordinates.",
          "title": "Position M"
        },
        "position_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Valid"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "MISSING_DATA",
                "STALE",
                "POSITION_OUT_OF_RANGE",
                "POSITION_JUMP",
                "STAMP_REGRESSION",
                "FRAME_MISMATCH",
                "STAMP_SKEW",
                "INVALID_DATA"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        }
      },
      "required": [
        "active",
        "fresh",
        "pose_age_s",
        "cloud_age_s",
        "position_valid",
        "reason_code",
        "reason",
        "position_m",
        "pose_hz",
        "cloud_hz"
      ],
      "title": "MappingPointLioStatus",
      "type": "object"
    },
    "MappingPreview": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
