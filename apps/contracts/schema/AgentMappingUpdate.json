{
  "$defs": {
    "MappingGlimPreview": {
      "additionalProperties": false,
      "description": "Independent coarse cumulative snapshot, never final-save evidence or Point-LIO cells.",
      "properties": {
        "cells": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "maximum": 40000,
                "minimum": -40000,
                "type": "integer"
              },
              {
                "maximum": 40000,
                "minimum": -40000,
                "type": "integer"
              },
              {
                "maximum": 40000,
                "minimum": -40000,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "maxItems": 1024,
          "title": "Cells",
          "type": "array"
        },
        "frame_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "resolution": {
          "const": 0.25,
          "default": 0.25,
          "title": "Resolution",
          "type": "number"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "const": "glim",
          "default": "glim",
          "title": "Source",
          "type": "string"
        },
        "stamp": {
          "$ref": "#/$defs/MappingStamp"
        }
      },
      "required": [
        "seq",
        "frame_id",
        "stamp",
        "cells"
      ],
      "title": "MappingGlimPreview",
      "type": "object"
    },
    "MappingGlimStatus": {
      "additionalProperties": false,
      "properties": {
        "data_age_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Age S"
        },
        "gpu": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the provider exposes no verified GPU evidence.",
          "title": "Gpu"
        },
        "processed_chunks": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Processed Chunks"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "stage": {
          "enum": [
            "OFF",
            "STARTING",
            "RECEIVING",
            "SAVING",
            "UNKNOWN"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "data_age_s",
        "processed_chunks",
        "gpu"
      ],
      "title": "MappingGlimStatus",
      "type": "object"
    },
    "MappingGrid": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "enum": [
              0,
              1,
              2
            ],
            "type": "integer"
