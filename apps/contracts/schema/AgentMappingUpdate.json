        "resolution": {
          "maximum": 100,
          "minimum": 0.1,
          "title": "Resolution",
          "type": "number"
        },
        "robot": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Robot"
        }
      },
      "required": [
        "resolution",
        "cells",
        "path"
      ],
      "title": "MappingPreview",
      "type": "object"
    },
    "MappingReportRejection": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
