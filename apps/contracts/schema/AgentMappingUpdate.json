  "$id": "fh-app/1/AgentMappingUpdate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "distance_m": {
      "default": 0,
      "maximum": 1000000,
      "minimum": 0,
      "title": "Distance M",
      "type": "number"
    },
    "elapsed_s": {
      "default": 0,
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Elapsed S",
      "type": "number"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "final_source": {
      "anyOf": [
        {
          "const": "glim",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Source"
    },
    "floor_id": {
      "format": "uuid",
      "title": "Floor Id",
      "type": "string"
    },
    "glim_preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/MappingGlimPreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/MappingGrid"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_report_rejection": {
      "anyOf": [
        {
          "$ref": "#/$defs/MappingReportRejection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "map_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Map Version Id"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "odom": {
      "anyOf": [
        {
          "$ref": "#/$defs/MappingOdom"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "phase": {
      "anyOf": [
        {
          "enum": [
            "START_REQUESTED",
            "STARTED",
            "SAVE_REQUESTED",
            "SLAM_SAVED",
            "UNKNOWN",
            "FAILED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phase"
    },
    "pipeline": {
      "anyOf": [
        {
          "const": "point_lio+glim",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
