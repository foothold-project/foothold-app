{
  "$id": "fh-app/1/Event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "category": {
      "enum": [
        "RUN",
        "ROUTE",
        "LINK",
        "LEASE",
        "APPROVAL",
        "SAFETY",
        "ACCOUNT"
      ],
      "title": "Category",
      "type": "string"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "id": {
      "pattern": "^[0-9]+$",
      "title": "Id",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "robot_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Robot At"
    },
    "robot_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Robot Id"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Run Id"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARN",
        "ERROR"
      ],
      "title": "Severity",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "User Id"
    }
  },
  "required": [
    "id",
    "at",
    "robot_at",
    "category",
    "code",
    "severity",
    "message",
    "robot_id",
    "user_id",
    "run_id",
    "data"
  ],
  "title": "Event",
  "type": "object"
}
