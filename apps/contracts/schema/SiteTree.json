{
  "$defs": {
    "MapBuilding": {
      "additionalProperties": false,
      "properties": {
        "floors": {
          "items": {
            "$ref": "#/$defs/MapFloor"
          },
          "title": "Floors",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sim_world_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim World Id"
        },
        "site_id": {
          "format": "uuid",
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "site_id",
        "name",
        "floors"
      ],
      "title": "MapBuilding",
      "type": "object"
    },
    "MapFloor": {
      "additionalProperties": false,
      "properties": {
        "approved_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved Version Id"
        },
        "building_id": {
          "format": "uuid",
          "title": "Building Id",
          "type": "string"
        },
        "floor_z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Z"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pending_count": {
          "default": 0,
          "title": "Pending Count",
          "type": "integer"
        },
        "provenance": {
          "default": "HUMAN",
          "enum": [
            "HUMAN",
            "SIMULATION"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "building_id",
        "name",
        "level",
        "approved_version_id",
        "pending_count"
      ],
      "title": "MapFloor",
      "type": "object"
    },
    "MapSite": {
      "additionalProperties": false,
      "properties": {
        "buildings": {
          "items": {
            "$ref": "#/$defs/MapBuilding"
          },
          "title": "Buildings",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "buildings"
      ],
      "title": "MapSite",
      "type": "object"
    }
  },
  "$id": "fh-app/1/SiteTree",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/MapSite"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "default": null,
      "title": "Next Cursor",
      "type": "null"
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "title": "SiteTree",
  "type": "object"
}
