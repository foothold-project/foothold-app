{
  "$defs": {
    "AgentAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "Damp",
            "BalanceStand",
            "StopMove",
            "StandUp",
            "StandDown",
            "RecoveryStand",
            "Euler",
            "Sit",
            "RiseSit",
            "SpeedLevel",
            "Hello",
            "Stretch",
            "Content",
            "Dance1",
            "Dance2",
            "SwitchJoystick",
            "Pose",
            "Scrape",
            "FrontFlip",
            "FrontJump",
            "FrontPounce",
            "Heart",
            "StaticWalk",
            "TrotRun",
            "EconomicGait",
            "LeftFlip",
            "BackFlip",
            "HandStand",
            "FreeWalk",
            "FreeBound",
            "FreeJump",
            "FreeAvoid",
            "ClassicWalk",
            "WalkUpright",
            "CrossStep",
            "AutoRecoverySet",
            "AutoRecoveryGet",
            "SwitchAvoidMode",
            "CheckMode",
            "SelectMode",
            "Greet"
          ],
          "title": "Action",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/Go2ActionParams"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "t": {
          "const": "action",
          "default": "action",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "action",
        "params",
        "confirmed",
        "t",
        "request_id",
        "lease_id"
      ],
      "title": "AgentAction",
      "type": "object"
    },
    "AgentCommand": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "items": {
            "maximum": 1,
            "minimum": -1,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Axes",
          "type": "array"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "t": {
          "const": "cmd",
          "default": "cmd",
          "title": "T",
          "type": "string"
        },
        "t_server": {
          "format": "date-time",
          "title": "T Server",
          "type": "string"
        }
      },
      "required": [
        "t",
        "lease_id",
        "seq",
        "axes",
        "t_server"
      ],
      "title": "AgentCommand",
      "type": "object"
    },
    "AgentFieldApproval": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "t": {
          "const": "field_approval",
          "default": "field_approval",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "expires_at"
      ],
      "title": "AgentFieldApproval",
      "type": "object"
    },
    "AgentGait": {
      "additionalProperties": false,
      "properties": {
        "gait": {
          "enum": [
            "classic",
            "sport",
            "start",
            "ame2"
          ],
          "title": "Gait",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "t": {
          "const": "gait",
          "default": "gait",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "request_id",
        "lease_id",
        "gait"
      ],
      "title": "AgentGait",
      "type": "object"
    },
    "AgentLease": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "anyOf": [
            {
              "enum": [
                "unknown",
                "user_stop",
                "lease_release",
                "lease_expired",
                "lease_take",
                "lease_transfer",
                "run_takeover",
                "transfer_canceled",
                "screen_hidden",
                "access_revoked",
                "robot_changed",
                "screen_auth_revoked",
                "screen_policy_stale",
                "screen_disconnected",
                "agent_auth_revoked",
                "agent_policy_stale",
                "agent_connected",
                "agent_disconnected",
                "agent_silent",
                "field_approval_revoked",
                "audit_unavailable",
                "run_finished",
                "transfer_access_lost",
                "archive_blocked",
                "drive_command_rejected",
                "drive_frame_invalid",
                "drive_settings_changed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause"
        },
        "holder_type": {
          "anyOf": [
            {
              "const": "USER",
              "type": "string"
            },
            {
              "pattern": "^RUN:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Holder Type"
        },
        "lease_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lease Id"
        },
        "t": {
          "const": "lease",
          "default": "lease",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "lease_id",
        "holder_type"
      ],
      "title": "AgentLease",
      "type": "object"
    },
    "AgentMappingCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "final_source": {
          "anyOf": [
            {
              "const": "glim",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Source"
        },
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "start",
            "save",
            "cancel"
          ],
          "title": "Op",
          "type": "string"
        },
        "pipeline": {
          "anyOf": [
            {
              "const": "point_lio+glim",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline"
        },
        "requested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested At"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "point_lio",
                "glim"
              ],
              "type": "string"
            },
            {
              "const": "legacy",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "t": {
          "const": "slam",
          "default": "slam",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "op",
        "session_id",
        "floor_id"
      ],
      "title": "AgentMappingCommand",
      "type": "object"
    },
    "AgentPhoneRevoke": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PhoneRevocationItem"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "t": {
          "const": "phone.revoke",
          "default": "phone.revoke",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "seq",
        "items"
      ],
      "title": "AgentPhoneRevoke",
      "type": "object"
    },
    "AgentPosture": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "stand_up",
            "stand_down"
          ],
          "title": "Action",
          "type": "string"
        },
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "t": {
          "const": "posture",
          "default": "posture",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "request_id",
        "lease_id",
        "action"
      ],
      "title": "AgentPosture",
      "type": "object"
    },
    "AgentServerPing": {
      "additionalProperties": false,
      "properties": {
        "ping_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ping Id"
        },
        "t": {
          "const": "ping",
          "default": "ping",
          "title": "T",
          "type": "string"
        },
        "t_server": {
          "format": "date-time",
          "title": "T Server",
          "type": "string"
        }
      },
      "required": [
        "t",
        "t_server",
        "ping_id"
      ],
      "title": "AgentServerPing",
      "type": "object"
    },
    "AgentStop": {
      "additionalProperties": false,
      "properties": {
        "by_user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "By User Id"
        },
        "cause": {
          "anyOf": [
            {
              "enum": [
                "unknown",
                "user_stop",
                "lease_release",
                "lease_expired",
                "lease_take",
                "lease_transfer",
                "run_takeover",
                "transfer_canceled",
                "screen_hidden",
                "access_revoked",
                "robot_changed",
                "screen_auth_revoked",
                "screen_policy_stale",
                "screen_disconnected",
                "agent_auth_revoked",
                "agent_policy_stale",
                "agent_connected",
                "agent_disconnected",
                "agent_silent",
                "field_approval_revoked",
                "audit_unavailable",
                "run_finished",
                "transfer_access_lost",
                "archive_blocked",
                "drive_command_rejected",
                "drive_frame_invalid",
                "drive_settings_changed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause"
        },
        "stop_ref": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Stop Ref",
          "type": "integer"
        },
        "t": {
          "const": "stop",
          "default": "stop",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "by_user_id",
        "stop_ref"
      ],
      "title": "AgentStop",
      "type": "object"
    },
    "AgentStreams": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "title": "Depth",
          "type": "boolean"
        },
        "lidar": {
          "title": "Lidar",
          "type": "boolean"
        },
        "map": {
          "title": "Map",
          "type": "boolean"
        },
        "rgb": {
          "title": "Rgb",
          "type": "boolean"
        },
        "t": {
          "const": "streams",
          "default": "streams",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "rgb",
        "depth",
        "lidar",
        "map"
      ],
      "title": "AgentStreams",
      "type": "object"
    },
    "AgentUnlock": {
      "additionalProperties": false,
      "properties": {
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "stop_gen": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Stop Gen",
          "type": "integer"
        },
        "t": {
          "const": "unlock",
          "default": "unlock",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "lease_id",
        "stop_gen"
      ],
      "title": "AgentUnlock",
      "type": "object"
    },
    "Go2ActionParams": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "mode": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "pitch": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch"
        },
        "roll": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roll"
        },
        "yaw": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yaw"
        }
      },
      "title": "Go2ActionParams",
      "type": "object"
    },
    "PhoneRevocationItem": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "jtis": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jtis"
        },
        "sub": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub"
        },
        "until": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Until",
          "type": "integer"
        }
      },
      "required": [
        "jtis",
        "sub",
        "device",
        "until"
      ],
      "title": "PhoneRevocationItem",
      "type": "object"
    },
    "RunRecorded": {
      "additionalProperties": false,
      "description": "Data receipt after DB commit; never an execution permission.",
      "properties": {
        "agent_instance_id": {
          "format": "uuid",
          "title": "Agent Instance Id",
          "type": "string"
        },
        "report_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Report Seq",
          "type": "integer"
        },
        "t": {
          "const": "run.recorded",
          "default": "run.recorded",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "agent_instance_id",
        "report_seq"
      ],
      "title": "RunRecorded",
      "type": "object"
    },
    "RunReportRejected": {
      "additionalProperties": false,
      "description": "Data rejection, never a commit ACK or an instruction to resume execution.",
      "properties": {
        "agent_instance_id": {
          "format": "uuid",
          "title": "Agent Instance Id",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "RUN_REPORT_SEQUENCE",
                "RUN_REPORT_STORAGE"
              ],
              "type": "string"
            },
            {
              "enum": [
                "RUN_REPORT_OWNER",
                "RUN_REPORT_MAP",
                "RUN_REPORT_PLAN",
                "RUN_REPORT_STATE",
                "RUN_REPORT_STEP",
                "RUN_REPORT_PROVENANCE",
                "RUN_REPORT_CONFLICT",
                "RUN_REPORT_INSTANCE",
                "RUN_REPORT_ROBOT",
                "RUN_REPORT_NOT_FOUND",
                "RUN_REPORT_INVALID"
              ],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "disposition": {
          "enum": [
            "RETRY",
            "QUARANTINE"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "expected_report_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Report Seq",
          "type": "integer"
        },
        "report_seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Report Seq",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "t": {
          "const": "run.report_rejected",
          "default": "run.report_rejected",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "agent_instance_id",
        "report_seq",
        "run_id",
        "disposition",
        "code"
      ],
      "title": "RunReportRejected",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ServerAgentMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "action": "#/$defs/AgentAction",
      "cmd": "#/$defs/AgentCommand",
      "field_approval": "#/$defs/AgentFieldApproval",
      "gait": "#/$defs/AgentGait",
      "lease": "#/$defs/AgentLease",
      "phone.revoke": "#/$defs/AgentPhoneRevoke",
      "ping": "#/$defs/AgentServerPing",
      "posture": "#/$defs/AgentPosture",
      "run.recorded": "#/$defs/RunRecorded",
      "run.report_rejected": "#/$defs/RunReportRejected",
      "slam": "#/$defs/AgentMappingCommand",
      "stop": "#/$defs/AgentStop",
      "streams": "#/$defs/AgentStreams",
      "unlock": "#/$defs/AgentUnlock"
    },
    "propertyName": "t"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AgentLease"
    },
    {
      "$ref": "#/$defs/AgentCommand"
    },
    {
      "$ref": "#/$defs/AgentStop"
    },
    {
      "$ref": "#/$defs/AgentUnlock"
    },
    {
      "$ref": "#/$defs/AgentServerPing"
    },
    {
      "$ref": "#/$defs/AgentStreams"
    },
    {
      "$ref": "#/$defs/AgentPhoneRevoke"
    },
    {
      "$ref": "#/$defs/RunRecorded"
    },
    {
      "$ref": "#/$defs/RunReportRejected"
    },
    {
      "$ref": "#/$defs/AgentFieldApproval"
    },
    {
      "$ref": "#/$defs/AgentMappingCommand"
    },
    {
      "$ref": "#/$defs/AgentPosture"
    },
    {
      "$ref": "#/$defs/AgentAction"
    },
    {
      "$ref": "#/$defs/AgentGait"
    }
  ]
}
