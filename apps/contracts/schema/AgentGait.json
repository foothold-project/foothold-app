{
  "$id": "fh-app/1/AgentGait",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "gait": {
      "enum": [
        "classic",
        "sport",
        "start",
        "ame2"
      ],
      "title": "Gait",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "t": {
      "const": "gait",
      "default": "gait",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "request_id",
    "lease_id",
    "gait"
  ],
  "title": "AgentGait",
  "type": "object"
}
