{
  "$id": "fh-app/1/PhoneRunControl",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "op": {
      "description": "return은 예약된 요청이며 항상 UNSUPPORTED_OPERATION으로 거부한다.",
      "enum": [
        "pause",
        "resume",
        "abort",
        "return"
      ],
      "title": "Op",
      "type": "string"
    },
    "proto": {
      "const": "fh-phone/1",
      "title": "Proto",
      "type": "string"
    },
    "resume_token": {
      "description": "같은 화면 재개의 비밀 증명. 에이전트는 해시만 보관하고 재바인딩 때 회전한다.",
      "minLength": 1,
      "title": "Resume Token",
      "type": "string"
    },
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "screen_id": {
      "format": "uuid",
      "title": "Screen Id",
      "type": "string"
    },
    "t": {
      "const": "run.control",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot",
    "t",
    "run_id",
    "op"
  ],
  "title": "PhoneRunControl",
  "type": "object"
}
