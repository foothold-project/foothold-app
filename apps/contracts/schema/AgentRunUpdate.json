{
  "$defs": {
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "title": "Progress",
      "type": "object"
    }
  },
  "$id": "fh-app/1/AgentRunUpdate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "fail_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fail Code"
    },
    "path_deviation_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path Deviation M"
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "maxLength": 64,
      "title": "Status",
      "type": "string"
    },
    "step": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "t": {
      "const": "run.update",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "run_id",
    "status",
    "step",
    "progress"
  ],
  "title": "AgentRunUpdate",
  "type": "object"
}
