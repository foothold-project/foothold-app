{
  "$defs": {
    "MediaPose": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "maximum": 3.141592653589793,
          "minimum": -3.141592653589793,
          "title": "Yaw",
          "type": "number"
        },
        "z": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "yaw"
      ],
      "title": "MediaPose",
      "type": "object"
    }
  },
  "$id": "fh-app/1/SlamPoseFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "channel": {
      "const": "slam_pose",
      "title": "Channel",
      "type": "string"
    },
    "child_frame": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_/-]+$",
      "title": "Child Frame",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "null"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "frame": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_/-]+$",
      "title": "Frame",
      "type": "string"
    },
    "pose": {
      "$ref": "#/$defs/MediaPose"
    },
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "source": {
      "enum": [
        "rt/uslam/frontend/odom",
        "rt/uslam/localization/odom"
      ],
      "title": "Source",
      "type": "string"
    },
    "t": {
      "const": "media.slam_pose",
      "title": "T",
      "type": "string"
    },
    "version": {
      "const": "media/1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "robot",
    "epoch",
    "episode_id",
    "version",
    "captured_at",
    "seq",
    "frame",
    "t",
    "channel",
    "source",
    "child_frame",
    "pose"
  ],
  "title": "SlamPoseFrame",
  "type": "object"
}
