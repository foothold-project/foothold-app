{
  "$id": "fh-app/1/MediaHello",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "enum": [
        "rgb",
        "external",
        "lidar"
      ],
      "title": "Channel",
      "type": "string"
    },
    "episode_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Episode Id"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "t": {
      "const": "media.hello",
      "title": "T",
      "type": "string"
    },
    "token": {
      "maxLength": 43,
      "minLength": 43,
      "title": "Token",
      "type": "string"
    },
    "version": {
      "const": "media/1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "robot",
    "epoch",
    "episode_id",
    "t",
    "version",
    "channel",
    "token"
  ],
  "title": "MediaHello",
  "type": "object"
}
