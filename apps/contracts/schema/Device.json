{
  "$defs": {
    "DeviceStatusCode": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "OK",
            "ACCEPTED",
            "ERROR"
          ],
          "title": "Level",
          "type": "string"
        },
        "raw": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Raw",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "const": "EXPLICIT_SERVER_ALLOWLIST",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "raw",
        "level",
        "reason"
      ],
      "title": "DeviceStatusCode",
      "type": "object"
    }
  },
  "$id": "fh-app/1/Device",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "key": {
      "title": "Key",
      "type": "string"
    },
    "kind": {
      "enum": [
        "CAMERA_RGB",
        "CAMERA_DEPTH",
        "LIDAR",
        "BATTERY",
        "OTHER"
      ],
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "state": {
      "enum": [
        "OK",
        "MISSING",
        "ERROR"
      ],
      "title": "State",
      "type": "string"
    },
    "status_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceStatusCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "key",
    "kind",
    "label",
    "state"
  ],
  "title": "Device",
  "type": "object"
}
