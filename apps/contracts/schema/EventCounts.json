  "$id": "fh-app/1/EventCounts",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Facet counts for the records filter panel (#613). Each facet applies every\nfilter except its own, so picking one category still shows the others' counts.",
  "properties": {
    "category": {
      "$ref": "#/$defs/EventCategoryCounts"
    },
    "clip": {
      "$ref": "#/$defs/EventClipCounts"
    },
    "severity": {
      "$ref": "#/$defs/EventSeverityCounts"
    },
    "simulation": {
      "$ref": "#/$defs/EventSimulationCounts"
    },
    "total": {
      "description": "모든 거르기를 건 사건 수 (cursor · limit 무시)",
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "total",
    "category",
    "severity",
    "simulation",
    "clip"
  ],
  "title": "EventCounts",
  "type": "object"
