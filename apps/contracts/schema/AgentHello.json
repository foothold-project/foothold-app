{
  "$defs": {
    "Device": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CAMERA_RGB",
            "CAMERA_DEPTH",
            "LIDAR",
            "BATTERY",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "OK",
            "MISSING",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "state"
      ],
      "title": "Device",
      "type": "object"
    },
    "ExecutionCapabilities": {
      "additionalProperties": false,
      "description": "Revision changes on executor/source/freshness/storage readiness changes.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ExecutionCapability"
          },
          "maxItems": 8,
          "title": "Actions",
          "type": "array"
        },
        "contract": {
          "const": "scenario/2",
          "title": "Contract",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "contract",
        "revision",
        "actions"
      ],
      "title": "ExecutionCapabilities",
      "type": "object"
    },
    "ExecutionCapability": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "wait",
            "photo.rgb",
            "photo.depth",
            "operator_confirm",
            "sensor_log.rgb",
            "sensor_log.depth",
            "sensor_log.lidar",
            "sensor_log.battery"
          ],
          "title": "Key",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "state": {
          "enum": [
            "SUPPORTED",
            "UNAVAILABLE",
            "UNSUPPORTED"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "key",
        "state",
        "reason"
      ],
      "title": "ExecutionCapability",
      "type": "object"
    },
    "RunCopy": {
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "maxLength": 64,
          "title": "Status",
          "type": "string"
        },
        "step": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "wait_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Reason"
        }
      },
      "required": [
        "run_id",
        "status",
        "step"
      ],
      "title": "RunCopy",
      "type": "object"
    }
  },
  "$id": "fh-app/1/AgentHello",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agent_version": {
      "maxLength": 128,
      "title": "Agent Version",
      "type": "string"
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/Device"
      },
      "title": "Devices",
      "type": "array"
    },
    "execution_capabilities": {
      "$ref": "#/$defs/ExecutionCapabilities"
    },
    "firmware": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Firmware"
    },
    "last_floor_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Floor Id"
    },
    "latched": {
      "title": "Latched",
      "type": "boolean"
    },
    "lease_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lease Id"
    },
    "map_versions": {
      "items": {
        "type": "string"
      },
      "title": "Map Versions",
      "type": "array"
    },
    "proto": {
      "const": "fh-agent/2",
      "title": "Proto",
      "type": "string"
    },
    "robot_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Robot Model"
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunCopy"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_gen": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Stop Gen",
      "type": "integer"
    },
    "t": {
      "const": "hello",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "proto",
    "agent_version",
    "robot_model",
    "firmware",
    "devices",
    "map_versions",
    "last_floor_id",
    "latched",
    "stop_gen",
    "lease_id",
    "run"
  ],
  "title": "AgentHello",
  "type": "object"
}
