{
  "$defs": {
    "Battery": {
      "additionalProperties": false,
      "properties": {
        "soc": {
          "maximum": 100,
          "minimum": 0,
          "title": "Soc",
          "type": "number"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "soc",
        "updated_at"
      ],
      "title": "Battery",
      "type": "object"
    },
    "CurrentRun": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "scenario_name": {
          "title": "Scenario Name",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "QUEUED",
                "PREPARING",
                "MOVING",
                "AT_WAYPOINT",
                "PERFORMING",
                "WAIT_CONFIRM",
                "PAUSED",
                "COMPLETED",
                "FAILED",
                "CANCELED"
              ],
              "type": "string"
            },
            {
              "const": "ABORTED",
              "type": "string"
            }
          ],
          "title": "Status"
        }
      },
      "required": [
        "id",
        "status",
        "scenario_name",
        "progress"
      ],
      "title": "CurrentRun",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CAMERA_RGB",
            "CAMERA_DEPTH",
            "LIDAR",
            "BATTERY",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "OK",
            "MISSING",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "state"
      ],
      "title": "Device",
      "type": "object"
    },
    "FloorContext": {
      "additionalProperties": false,
      "description": "Observation identity; compare the entire token before using asynchronous map results.\n\nThis context never grants control or changes STOP/deadman gates. Positions are\nabsent during transit/unknown and when the approved grid binding is invalid.",
      "properties": {
        "building_id": {
          "format": "uuid",
          "title": "Building Id",
          "type": "string"
        },
        "confirmed_sim_t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed Sim T"
        },
        "current_floor_id": {
          "anyOf": [
            {
              "enum": [
                "l1",
                "l2",
                "f1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Floor Id"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "floor_rev": {
          "minimum": 0,
          "title": "Floor Rev",
          "type": "integer"
        },
        "floor_state": {
          "enum": [
            "on_floor",
            "transit",
            "unknown"
          ],
          "title": "Floor State",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Version Id"
        },
        "reason": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "source": {
          "const": "gt_geometry",
          "title": "Source",
          "type": "string"
        },
        "source_pgm_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Pgm Sha256"
        },
        "spawn_floor_id": {
          "enum": [
            "l1",
            "l2",
            "f1"
          ],
          "title": "Spawn Floor Id",
          "type": "string"
        },
        "world_id": {
          "enum": [
            "v5_building",
            "warehouse",
            "rubble"
          ],
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "robot_id",
        "generation",
        "run_id",
        "epoch",
        "floor_rev",
        "world_id",
        "building_id",
        "spawn_floor_id",
        "current_floor_id",
        "floor_id",
        "map_version_id",
        "sha256",
        "source_pgm_sha256",
        "source",
        "floor_state",
        "reason",
        "confirmed_sim_t"
      ],
      "title": "FloorContext",
      "type": "object"
    },
    "Lease": {
      "additionalProperties": false,
      "properties": {
        "holder_type": {
          "enum": [
            "USER",
            "RUN"
          ],
          "title": "Holder Type",
          "type": "string"
        },
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/Person"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "holder_type",
        "user",
        "since"
      ],
      "title": "Lease",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "floor_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/FloorContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Version Id"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yaw"
        }
      },
      "required": [
        "floor_id",
        "map_version_id",
        "x",
        "y",
        "yaw",
        "confidence",
        "updated_at"
      ],
      "title": "Location",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name"
      ],
      "title": "Person",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "title": "Progress",
      "type": "object"
    }
  },
  "$id": "fh-app/1/RobotSummary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attention": {
      "items": {
        "type": "string"
      },
      "title": "Attention",
      "type": "array"
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/Battery"
        },
        {
          "type": "null"
        }
      ]
    },
    "connection": {
      "enum": [
        "ONLINE",
        "OFFLINE",
        "UNKNOWN"
      ],
      "title": "Connection",
      "type": "string"
    },
    "current_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrentRun"
        },
        {
          "type": "null"
        }
      ]
    },
    "devices": {
      "items": {
        "$ref": "#/$defs/Device"
      },
      "title": "Devices",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "lease": {
      "anyOf": [
        {
          "$ref": "#/$defs/Lease"
        },
        {
          "type": "null"
        }
      ]
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "$ref": "#/$defs/Person"
        },
        {
          "type": "null"
        }
      ]
    },
    "simulation": {
      "default": false,
      "title": "Simulation",
      "type": "boolean"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "IDLE",
            "TELEOP",
            "RUNNING",
            "PAUSED",
            "STOP_LATCHED",
            "ERROR"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Status"
    }
  },
  "required": [
    "simulation",
    "id",
    "name",
    "model",
    "owner",
    "connection",
    "status",
    "battery",
    "location",
    "lease",
    "current_run",
    "devices",
    "attention"
  ],
  "title": "RobotSummary",
  "type": "object"
}
