{
  "$defs": {
    "AgentBattery": {
      "properties": {
        "soc": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Soc"
        },
        "voltage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage"
        }
      },
      "required": [
        "soc"
      ],
      "title": "AgentBattery",
      "type": "object"
    },
    "AgentPose": {
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Version Id"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yaw"
        }
      },
      "required": [
        "floor_id",
        "x",
        "y",
        "yaw",
        "confidence"
      ],
      "title": "AgentPose",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CAMERA_RGB",
            "CAMERA_DEPTH",
            "LIDAR",
            "BATTERY",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "OK",
            "MISSING",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "state"
      ],
      "title": "Device",
      "type": "object"
    },
    "PhoneEcho": {
      "additionalProperties": false,
      "properties": {
        "agent_time_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Agent Time Ms",
          "type": "integer"
        },
        "client_time_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Client Time Ms",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "client_time_ms",
        "agent_time_ms"
      ],
      "title": "PhoneEcho",
      "type": "object"
    },
    "PhonePosture": {
      "additionalProperties": false,
      "properties": {
        "body_still": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Body Still"
        },
        "fallen": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fallen"
        },
        "tilt_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tilt Deg"
        },
        "z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Z"
        }
      },
      "required": [
        "z",
        "tilt_deg",
        "fallen",
        "body_still"
      ],
      "title": "PhonePosture",
      "type": "object"
    }
  },
  "$id": "fh-app/1/PhoneState",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "applied": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Applied",
      "type": "array"
    },
    "battery": {
      "$ref": "#/$defs/AgentBattery"
    },
    "controller": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Controller"
    },
    "controller_connected": {
      "title": "Controller Connected",
      "type": "boolean"
    },
    "controller_device": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Controller Device"
    },
    "devices_changed": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Device"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Devices Changed"
    },
    "echo": {
      "anyOf": [
        {
          "$ref": "#/$defs/PhoneEcho"
        },
        {
          "type": "null"
        }
      ]
    },
    "latched": {
      "title": "Latched",
      "type": "boolean"
    },
    "lease_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lease Id"
    },
    "mode": {
      "maxLength": 64,
      "title": "Mode",
      "type": "string"
    },
    "pose": {
      "$ref": "#/$defs/AgentPose"
    },
    "posture": {
      "$ref": "#/$defs/PhonePosture"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "sim_time_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sim Time S"
    },
    "sim_wall_delta_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sim Wall Delta S"
    },
    "simulation": {
      "title": "Simulation",
      "type": "boolean"
    },
    "speed": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Speed"
    },
    "stop_gen": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Stop Gen",
      "type": "integer"
    },
    "stop_ref": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Stop Ref",
      "type": "integer"
    },
    "stop_requested": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stop Requested"
    },
    "t": {
      "const": "state",
      "title": "T",
      "type": "string"
    },
    "velocity": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      ],
      "title": "Velocity",
      "type": "array"
    },
    "wall_time_ms": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Wall Time Ms",
      "type": "integer"
    }
  },
  "required": [
    "t",
    "pose",
    "speed",
    "battery",
    "latched",
    "stop_gen",
    "stop_ref",
    "applied",
    "mode",
    "robot",
    "controller",
    "controller_device",
    "controller_connected",
    "lease_id",
    "stop_requested",
    "posture",
    "velocity",
    "echo",
    "wall_time_ms",
    "sim_time_s",
    "sim_wall_delta_s",
    "simulation"
  ],
  "title": "PhoneState",
  "type": "object"
}
