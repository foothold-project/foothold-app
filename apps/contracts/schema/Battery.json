{
  "$id": "fh-app/1/Battery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "minutes_left": {
      "anyOf": [
        {
          "maximum": 1440,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minutes Left"
    },
    "soc": {
      "maximum": 100,
      "minimum": 0,
      "title": "Soc",
      "type": "number"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "soc",
    "updated_at"
  ],
  "title": "Battery",
  "type": "object"
}
