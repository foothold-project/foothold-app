{
  "$defs": {
    "UnlockAxis": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "enum": [
            "vx",
            "vy",
            "vz",
            "wz",
            "gyro_x",
            "gyro_y",
            "gyro_z",
            "joint_0",
            "joint_1",
            "joint_2",
            "joint_3",
            "joint_4",
            "joint_5",
            "joint_6",
            "joint_7",
            "joint_8",
            "joint_9",
            "joint_10",
            "joint_11"
          ],
          "title": "Axis",
          "type": "string"
        },
        "limit": {
          "exclusiveMinimum": 0,
          "title": "Limit",
          "type": "number"
        },
        "unit": {
          "enum": [
            "m/s",
            "rad/s"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "axis",
        "value",
        "limit",
        "unit"
      ],
      "title": "UnlockAxis",
      "type": "object"
    }
  },
  "$id": "fh-app/1/UnlockRefused",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "axes": {
      "items": {
        "$ref": "#/$defs/UnlockAxis"
      },
      "maxItems": 19,
      "title": "Axes",
      "type": "array"
    },
    "reason": {
      "enum": [
        "LEASE_UNCONFIRMED",
        "LEASE_MISMATCH",
        "INVALID_GENERATION",
        "OUTPUT_HELD",
        "NO_CONTROLLER",
        "NOT_LATCHED",
        "GENERATION_MISMATCH",
        "RESET_PENDING",
        "RESUME_PENDING",
        "STOP_UNCONFIRMED",
        "STATE_UNSEEN",
        "STATE_STALE",
        "STATE_RESETTING",
        "POLICY_NOT_RUNNING",
        "SIM_BUSY",
        "STILL_MOVING"
      ],
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "reason",
    "at",
    "axes"
  ],
  "title": "UnlockRefused",
  "type": "object"
}
