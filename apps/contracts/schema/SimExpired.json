{
  "$id": "fh-app/1/SimExpired",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "reason": {
      "const": "time_limit",
      "default": "time_limit",
      "title": "Reason",
      "type": "string"
    },
    "robot_id": {
      "format": "uuid",
      "title": "Robot Id",
      "type": "string"
    }
  },
  "required": [
    "robot_id",
    "owner_id",
    "generation",
    "reason"
  ],
  "title": "SimExpired",
  "type": "object"
}
