{
  "$id": "fh-app/1/MediaHeader",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "channel": {
      "enum": [
        "rgb",
        "external",
        "lidar"
      ],
      "title": "Channel",
      "type": "string"
    },
    "episode_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Episode Id"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "frame": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_/-]+$",
      "title": "Frame",
      "type": "string"
    },
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "source": {
      "enum": [
        "d435i_rgb",
        "go2_front",
        "gazebo_external",
        "l1"
      ],
      "title": "Source",
      "type": "string"
    },
    "version": {
      "const": "media/1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "robot",
    "epoch",
    "episode_id",
    "version",
    "channel",
    "source",
    "seq",
    "captured_at",
    "frame"
  ],
  "title": "MediaHeader",
  "type": "object"
}
