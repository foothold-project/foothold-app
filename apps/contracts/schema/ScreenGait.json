{
  "$id": "fh-app/1/ScreenGait",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "gait": {
      "enum": [
        "classic",
        "sport",
        "start",
        "ame2"
      ],
      "title": "Gait",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "proto": {
      "const": "fh-rt/1",
      "description": "첫 메시지는 필수, 후속은 생략 가능; null은 거부한다.",
      "title": "Proto",
      "type": "string"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "t": {
      "const": "gait",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot",
    "t",
    "lease_id",
    "gait"
  ],
  "title": "ScreenGait",
  "type": "object"
}
