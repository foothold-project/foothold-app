{
  "$defs": {
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "title": "Progress",
      "type": "object"
    }
  },
  "$id": "fh-app/1/RunSnapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fail_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fail Code"
    },
    "progress": {
      "$ref": "#/$defs/Progress"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "QUEUED",
        "PREPARING",
        "MOVING",
        "AT_WAYPOINT",
        "PERFORMING",
        "WAIT_CONFIRM",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELED"
      ],
      "title": "Status",
      "type": "string"
    },
    "step": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "wait_reason": {
      "anyOf": [
        {
          "enum": [
            "LINK_LOST",
            "STOPPED_BY_USER",
            "RECORDING_UNAVAILABLE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Wait Reason"
    }
  },
  "required": [
    "run_id",
    "status",
    "step",
    "progress",
    "wait_reason",
    "fail_code"
  ],
  "title": "RunSnapshot",
  "type": "object"
}
