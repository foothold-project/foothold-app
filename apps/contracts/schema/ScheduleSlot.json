{
  "$id": "fh-app/1/ScheduleSlot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Assignment Id"
    },
    "busy_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Busy Label"
    },
    "confirmed_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed By"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "gait": {
      "anyOf": [
        {
          "enum": [
            "classic",
            "sport",
            "start",
            "ame2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Gait"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "CONFIRMED",
        "DRAFT",
        "BATTERY_SWAP",
        "MAINTENANCE"
      ],
      "title": "Kind",
      "type": "string"
    },
    "memo": {
      "title": "Memo",
      "type": "string"
    },
    "robot_id": {
      "format": "uuid",
      "title": "Robot Id",
      "type": "string"
    },
    "run_code": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Code"
    },
    "run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "run_state": {
      "anyOf": [
        {
          "enum": [
            "STARTING",
            "STARTED",
            "DONE",
            "FAILED",
            "SKIPPED",
            "MISSED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run State"
    },
    "scenario_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scenario Id"
    },
    "scenario_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scenario Version"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot_id",
    "scenario_id",
    "scenario_version",
    "gait",
    "start",
    "end",
    "kind",
    "assignment_id",
    "memo",
    "created_by",
    "created_at",
    "run_state",
    "run_id",
    "run_code",
    "confirmed_by"
  ],
  "title": "ScheduleSlot",
  "type": "object"
}
