{
  "$id": "fh-app/1/CameraHello",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "t": {
      "const": "camera.hello",
      "title": "T",
      "type": "string"
    },
    "token": {
      "maxLength": 43,
      "minLength": 43,
      "title": "Token",
      "type": "string"
    }
  },
  "required": [
    "t",
    "robot",
    "token"
  ],
  "title": "CameraHello",
  "type": "object"
}
