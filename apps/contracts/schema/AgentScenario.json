{
  "$defs": {
    "AgentScenarioWaypoint": {
      "additionalProperties": false,
      "properties": {
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "map_version_id": {
          "format": "uuid",
          "title": "Map Version Id",
          "type": "string"
        },
        "mission_id": {
          "format": "uuid",
          "title": "Mission Id",
          "type": "string"
        },
        "mission_name": {
          "title": "Mission Name",
          "type": "string"
        },
        "mission_version": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Mission Version",
          "type": "integer"
        },
        "waypoint_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waypoint Ref"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "default": 0,
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "floor_id",
        "map_version_id",
        "x",
        "y",
        "mission_id",
        "mission_version",
        "mission_name"
      ],
      "title": "AgentScenarioWaypoint",
      "type": "object"
    },
    "ScenarioFinish": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "STAY",
          "enum": [
            "STAY",
            "RETURN_TO_START",
            "GO_TO"
          ],
          "title": "Mode",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ScenarioFinish",
      "type": "object"
    },
    "ScenarioPoint": {
      "additionalProperties": false,
      "properties": {
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "map_version_id": {
          "format": "uuid",
          "title": "Map Version Id",
          "type": "string"
        },
        "waypoint_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waypoint Ref"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "default": 0,
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "floor_id",
        "map_version_id",
        "x",
        "y"
      ],
      "title": "ScenarioPoint",
      "type": "object"
    }
  },
  "$id": "fh-app/1/AgentScenario",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "GET /agent/scenarios/{id}?version=n: stored references, before agent validation.",
  "properties": {
    "finish": {
      "$ref": "#/$defs/ScenarioFinish"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "number": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Number",
      "type": "integer"
    },
    "waypoints": {
      "items": {
        "$ref": "#/$defs/AgentScenarioWaypoint"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Waypoints",
      "type": "array"
    }
  },
  "required": [
    "id",
    "number",
    "waypoints",
    "finish"
  ],
  "title": "AgentScenario",
  "type": "object"
}
