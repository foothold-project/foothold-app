{
  "$id": "fh-app/1/SimStartRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "demo": {
      "default": false,
      "description": "새로 여는 세대를 데모 로봇으로 둔다. 이미 같은 사람이 쓰는 슬롯이면 바꾸지 않는다.",
      "title": "Demo",
      "type": "boolean"
    },
    "robot_id": {
      "format": "uuid",
      "title": "Robot Id",
      "type": "string"
    },
    "spawn_floor_id": {
      "anyOf": [
        {
          "enum": [
            "l1",
            "l2",
            "l3"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spawn Floor Id"
    },
    "world_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "world_id",
    "robot_id"
  ],
  "title": "SimStartRequest",
  "type": "object"
}
