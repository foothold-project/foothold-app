{
  "$defs": {
    "ApprovalAssignmentPreview": {
      "additionalProperties": false,
      "properties": {
        "effective_scenario_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Scenario Version"
        },
        "robot_id": {
          "format": "uuid",
          "title": "Robot Id",
          "type": "string"
        },
        "robot_name": {
          "title": "Robot Name",
          "type": "string"
        },
        "scenario_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scenario Id"
        },
        "scenario_name": {
          "title": "Scenario Name",
          "type": "string"
        },
        "scenario_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scenario Version"
        }
      },
      "required": [
        "scenario_id",
        "scenario_name",
        "scenario_version",
        "robot_id",
        "robot_name"
      ],
      "title": "ApprovalAssignmentPreview",
      "type": "object"
    },
    "ApprovalMapPreview": {
      "additionalProperties": false,
      "properties": {
        "base_version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Version Number"
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "floor_name": {
          "title": "Floor Name",
          "type": "string"
        },
        "target_version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Version Number"
        }
      },
      "required": [
        "floor_id",
        "floor_name",
        "target_version_number",
        "base_version_number"
      ],
      "title": "ApprovalMapPreview",
      "type": "object"
    },
    "ApprovalRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "type": {
          "default": "map_version",
          "enum": [
            "map_version",
            "assignment"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "ApprovalRef",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name"
      ],
      "title": "Person",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ApprovalDetail",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decided At"
    },
    "decider": {
      "anyOf": [
        {
          "$ref": "#/$defs/Person"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decision Comment"
    },
    "emergency": {
      "default": false,
      "title": "Emergency",
      "type": "boolean"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "MAP_REVISION",
        "MAP_ROLLBACK",
        "SCENARIO_ASSIGNMENT"
      ],
      "title": "Kind",
      "type": "string"
    },
    "preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalMapPreview"
        },
        {
          "$ref": "#/$defs/ApprovalAssignmentPreview"
        }
      ],
      "title": "Preview"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "requester": {
      "$ref": "#/$defs/Person"
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "CANCELED",
        "STALE"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ApprovalRef"
    }
  },
  "required": [
    "id",
    "kind",
    "status",
    "requester",
    "decider",
    "reason",
    "decision_comment",
    "target",
    "base_ref",
    "emergency",
    "created_at",
    "decided_at",
    "preview"
  ],
  "title": "ApprovalDetail",
  "type": "object"
}
