{
  "$defs": {
    "Go2Attitude": {
      "additionalProperties": false,
      "description": "Display-only LowState IMU rpy, radians; invalid axes become unknown.",
      "properties": {
        "pitch": {
          "anyOf": [
            {
              "maximum": 3.141592653589793,
              "minimum": -3.141592653589793,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pitch"
        },
        "roll": {
          "anyOf": [
            {
              "maximum": 3.141592653589793,
              "minimum": -3.141592653589793,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Roll"
        }
      },
      "required": [
        "roll",
        "pitch"
      ],
      "title": "Go2Attitude",
      "type": "object"
    }
  },
  "$id": "fh-app/1/Go2RobotInfo",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Readout only; never an input to STOP, lease, readiness or accepted codes.",
  "properties": {
    "attitude": {
      "$ref": "#/$defs/Go2Attitude"
    },
    "error_code": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "SportModeState raw uint32; firmware may use motion-state numbers (100=Agile in V2).",
      "title": "Error Code"
    },
    "fallen": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fallen"
    },
    "fallen_source": {
      "const": "imu_tilt_estimate",
      "title": "Fallen Source",
      "type": "string"
    },
    "source": {
      "const": "GO2_DDS",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "source",
    "attitude",
    "error_code",
    "fallen",
    "fallen_source"
  ],
  "title": "Go2RobotInfo",
  "type": "object"
}
