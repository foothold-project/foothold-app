{
  "$defs": {
    "ScenarioFinish": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "STAY",
          "enum": [
            "STAY",
            "RETURN_TO_START",
            "GO_TO"
          ],
          "title": "Mode",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ScenarioFinish",
      "type": "object"
    },
    "ScenarioPoint": {
      "additionalProperties": false,
      "properties": {
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "map_version_id": {
          "format": "uuid",
          "title": "Map Version Id",
          "type": "string"
        },
        "waypoint_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waypoint Ref"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "default": 0,
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "floor_id",
        "map_version_id",
        "x",
        "y"
      ],
      "title": "ScenarioPoint",
      "type": "object"
    },
    "ScenarioWaypoint": {
      "additionalProperties": false,
      "properties": {
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "map_version_id": {
          "format": "uuid",
          "title": "Map Version Id",
          "type": "string"
        },
        "mission_id": {
          "format": "uuid",
          "title": "Mission Id",
          "type": "string"
        },
        "mission_version": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Mission Version",
          "type": "integer"
        },
        "waypoint_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waypoint Ref"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "default": 0,
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "floor_id",
        "map_version_id",
        "x",
        "y",
        "mission_id",
        "mission_version"
      ],
      "title": "ScenarioWaypoint",
      "type": "object"
    }
  },
  "$id": "fh-app/1/ScenarioWrite",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "finish": {
      "$ref": "#/$defs/ScenarioFinish"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 4000,
      "title": "Notes",
      "type": "string"
    },
    "waypoints": {
      "items": {
        "$ref": "#/$defs/ScenarioWaypoint"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Waypoints",
      "type": "array"
    }
  },
  "required": [
    "name",
    "waypoints"
  ],
  "title": "ScenarioWrite",
  "type": "object"
}
