{
  "$id": "fh-app/1/PairingOfferClaim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[A-Za-z0-9_-]{24}$",
      "title": "Code",
      "type": "string"
    },
    "robot_serial": {
      "pattern": "^(0|[1-9][0-9]{0,9})-(0|[1-9][0-9]{0,9})$",
      "title": "Robot Serial",
      "type": "string"
    }
  },
  "required": [
    "code",
    "robot_serial"
  ],
  "title": "PairingOfferClaim",
  "type": "object"
}
