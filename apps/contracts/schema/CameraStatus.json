{
  "$id": "fh-app/1/CameraStatus",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "state": {
      "const": "NO_VIDEO",
      "title": "State",
      "type": "string"
    },
    "t": {
      "const": "camera.status",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "robot",
    "state"
  ],
  "title": "CameraStatus",
  "type": "object"
}
