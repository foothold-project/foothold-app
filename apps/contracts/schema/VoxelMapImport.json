{
  "$defs": {
    "MapConnector": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "STAIRS",
            "ELEVATOR"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pair_floor_id": {
          "format": "uuid",
          "title": "Pair Floor Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "pair_floor_id",
        "x",
        "y",
        "yaw"
      ],
      "title": "MapConnector",
      "type": "object"
    },
    "MapEdit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "op": {
          "enum": [
            "ERASE",
            "WALL"
          ],
          "title": "Op",
          "type": "string"
        },
        "polyline": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 256,
          "minItems": 2,
          "title": "Polyline",
          "type": "array"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "op",
        "polyline",
        "width"
      ],
      "title": "MapEdit",
      "type": "object"
    },
    "MapFeatures": {
      "additionalProperties": false,
      "properties": {
        "connectors": {
          "items": {
            "$ref": "#/$defs/MapConnector"
          },
          "maxItems": 256,
          "title": "Connectors",
          "type": "array"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/MapEdit"
          },
          "maxItems": 256,
          "title": "Edits",
          "type": "array"
        },
        "waypoints": {
          "items": {
            "$ref": "#/$defs/MapWaypoint"
          },
          "maxItems": 1000,
          "title": "Waypoints",
          "type": "array"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/MapZone"
          },
          "maxItems": 256,
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "zones",
        "waypoints",
        "connectors",
        "edits"
      ],
      "title": "MapFeatures",
      "type": "object"
    },
    "MapVersion": {
      "additionalProperties": false,
      "properties": {
        "base_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Version Id"
        },
        "copied_from_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copied From Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "features": {
          "$ref": "#/$defs/MapFeatures"
        },
        "floor_id": {
          "format": "uuid",
          "title": "Floor Id",
          "type": "string"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "image_sha256": {
          "title": "Image Sha256",
          "type": "string"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "origin": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "provenance": {
          "default": "HUMAN",
          "enum": [
            "HUMAN",
            "SIMULATION"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "resolution": {
          "title": "Resolution",
          "type": "number"
        },
        "source": {
          "enum": [
            "IMPORT",
            "EDIT",
            "ROLLBACK",
            "SLAM"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "APPROVED",
            "SUPERSEDED",
            "PENDING",
            "REJECTED",
            "CANCELED"
          ],
          "title": "Status",
          "type": "string"
        },
        "terrain_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerrainSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upload_id": {
          "format": "uuid",
          "title": "Upload Id",
          "type": "string"
        },
        "voxel_map": {
          "anyOf": [
            {
              "$ref": "#/$defs/VoxelMapSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "upload_id",
        "id",
        "floor_id",
        "number",
        "base_version_id",
        "copied_from_id",
        "status",
        "image_sha256",
        "width",
        "height",
        "resolution",
        "origin",
        "features",
        "reason",
        "source",
        "created_by",
        "created_at"
      ],
      "title": "MapVersion",
      "type": "object"
    },
    "MapWaypoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "y",
        "yaw"
      ],
      "title": "MapWaypoint",
      "type": "object"
    },
    "MapZone": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "type": {
            "const": "NO_GO"
          }
        }
      },
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "max_speed_mps": {
          "anyOf": [
            {
              "maximum": 1.5,
              "minimum": 0.3,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Speed Mps"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 256,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "type": {
          "enum": [
            "NO_GO",
            "SLOW"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "polygon"
      ],
      "then": {
        "not": {
          "required": [
            "max_speed_mps"
          ]
        }
      },
      "title": "MapZone",
      "type": "object"
    },
    "Terrain": {
      "additionalProperties": false,
      "properties": {
        "archived_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archived At"
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "map_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Version Id"
        },
        "spec": {
          "$ref": "#/$defs/TerrainSpec"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "spec",
        "version",
        "floor_id",
        "map_version_id",
        "archived_at",
        "updated_at"
      ],
      "title": "Terrain",
      "type": "object"
    },
    "TerrainBox": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "H",
          "type": "number"
        },
        "kind": {
          "const": "box",
          "title": "Kind",
          "type": "string"
        },
        "sx": {
          "exclusiveMinimum": 0,
          "title": "Sx",
          "type": "number"
        },
        "sy": {
          "exclusiveMinimum": 0,
          "title": "Sy",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw",
        "kind",
        "sx",
        "sy",
        "h"
      ],
      "title": "TerrainBox",
      "type": "object"
    },
    "TerrainGap": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gap",
          "title": "Kind",
          "type": "string"
        },
        "length": {
          "exclusiveMinimum": 0,
          "title": "Length",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw",
        "kind",
        "length",
        "width"
      ],
      "title": "TerrainGap",
      "type": "object"
    },
    "TerrainRamp": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "H",
          "type": "number"
        },
        "kind": {
          "const": "ramp",
          "title": "Kind",
          "type": "string"
        },
        "length": {
          "exclusiveMinimum": 0,
          "title": "Length",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw",
        "kind",
        "length",
        "width",
        "h"
      ],
      "title": "TerrainRamp",
      "type": "object"
    },
    "TerrainSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z0-9-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "box": "#/$defs/TerrainBox",
                "gap": "#/$defs/TerrainGap",
                "ramp": "#/$defs/TerrainRamp",
                "stairs": "#/$defs/TerrainStairs"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TerrainBox"
              },
              {
                "$ref": "#/$defs/TerrainStairs"
              },
              {
                "$ref": "#/$defs/TerrainRamp"
              },
              {
                "$ref": "#/$defs/TerrainGap"
              }
            ]
          },
          "maxItems": 60,
          "title": "Items",
          "type": "array"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "schema": {
          "const": "fh_custom_terrain/1",
          "title": "Schema",
          "type": "string"
        },
        "size": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 30,
              "minimum": 4,
              "type": "number"
            },
            {
              "maximum": 30,
              "minimum": 4,
              "type": "number"
            }
          ],
          "title": "Size",
          "type": "array"
        },
        "spawn": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Spawn",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "id",
        "name",
        "size",
        "spawn",
        "items"
      ],
      "title": "TerrainSpec",
      "type": "object"
    },
    "TerrainStairs": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stairs",
          "title": "Kind",
          "type": "string"
        },
        "rise": {
          "maximum": 0.25,
          "minimum": 0.02,
          "title": "Rise",
          "type": "number"
        },
        "run": {
          "minimum": 0.15,
          "title": "Run",
          "type": "number"
        },
        "steps": {
          "maximum": 50,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "yaw",
        "kind",
        "width",
        "steps",
        "rise",
        "run"
      ],
      "title": "TerrainStairs",
      "type": "object"
    },
    "VoxelMapSummary": {
      "additionalProperties": false,
      "description": "Coordinates: origin + (cell index + .5) * voxel_size, XYZ in metres.",
      "properties": {
        "cells_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cells Sha256",
          "type": "string"
        },
        "estimated_floor_z": {
          "title": "Estimated Floor Z",
          "type": "number"
        },
        "map_version_id": {
          "format": "uuid",
          "title": "Map Version Id",
          "type": "string"
        },
        "origin": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "point_count": {
          "maximum": 5000000,
          "minimum": 1,
          "title": "Point Count",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_translation": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Source Translation",
          "type": "array"
        },
        "terrain_id": {
          "title": "Terrain Id",
          "type": "string"
        },
        "voxel_count": {
          "maximum": 500000,
          "minimum": 1,
          "title": "Voxel Count",
          "type": "integer"
        },
        "voxel_size": {
          "const": 0.1,
          "default": 0.1,
          "title": "Voxel Size",
          "type": "number"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "map_version_id",
        "terrain_id",
        "voxel_size",
        "point_count",
        "voxel_count",
        "origin",
        "source_translation",
        "estimated_floor_z",
        "source_sha256",
        "cells_sha256",
        "warnings"
      ],
      "title": "VoxelMapSummary",
      "type": "object"
    }
  },
  "$id": "fh-app/1/VoxelMapImport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "map": {
      "$ref": "#/$defs/MapVersion"
    },
    "terrain": {
      "$ref": "#/$defs/Terrain"
    },
    "voxels": {
      "$ref": "#/$defs/VoxelMapSummary"
    }
  },
  "required": [
    "map",
    "terrain",
    "voxels"
  ],
  "title": "VoxelMapImport",
  "type": "object"
}
