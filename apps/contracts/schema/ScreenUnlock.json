{
  "$id": "fh-app/1/ScreenUnlock",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "proto": {
      "anyOf": [
        {
          "const": "fh-rt/1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proto"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "stop_gen": {
      "minimum": 0,
      "title": "Stop Gen",
      "type": "integer"
    },
    "t": {
      "const": "unlock",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot",
    "t",
    "lease_id",
    "stop_gen"
  ],
  "title": "ScreenUnlock",
  "type": "object"
}
