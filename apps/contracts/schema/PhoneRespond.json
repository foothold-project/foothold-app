{
  "$id": "fh-app/1/PhoneRespond",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accept": {
      "title": "Accept",
      "type": "boolean"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "proto": {
      "const": "fh-phone/1",
      "title": "Proto",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "t": {
      "const": "lease.respond",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot",
    "t",
    "request_id",
    "accept"
  ],
  "title": "PhoneRespond",
  "type": "object"
}
