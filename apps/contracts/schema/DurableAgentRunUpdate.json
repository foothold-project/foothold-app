{
  "$defs": {
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "done",
        "total"
      ],
      "title": "Progress",
      "type": "object"
    }
  },
  "$id": "fh-app/1/DurableAgentRunUpdate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Required for every new persistent run transition; legacy input is read-only.",
  "properties": {
    "agent_instance_id": {
      "format": "uuid",
      "title": "Agent Instance Id",
      "type": "string"
    },
    "fail_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fail Code"
    },
    "monotonic_s": {
      "minimum": 0,
      "title": "Monotonic S",
      "type": "number"
    },
    "path_deviation_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path Deviation M"
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "type": "null"
        }
      ]
    },
    "report_seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Report Seq",
      "type": "integer"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "QUEUED",
        "PREPARING",
        "MOVING",
        "AT_WAYPOINT",
        "PERFORMING",
        "WAIT_CONFIRM",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELED"
      ],
      "title": "Status",
      "type": "string"
    },
    "step": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "t": {
      "const": "run.update",
      "title": "T",
      "type": "string"
    },
    "wait_reason": {
      "anyOf": [
        {
          "enum": [
            "LINK_LOST",
            "STOPPED_BY_USER",
            "RECORDING_UNAVAILABLE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wait Reason"
    }
  },
  "required": [
    "t",
    "run_id",
    "status",
    "step",
    "progress",
    "agent_instance_id",
    "report_seq",
    "monotonic_s"
  ],
  "title": "DurableAgentRunUpdate",
  "type": "object"
}
