{
  "$id": "fh-app/1/ScreenSub",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "proto": {
      "const": "fh-rt/1",
      "description": "첫 메시지는 필수, 후속은 생략 가능; null은 거부한다.",
      "title": "Proto",
      "type": "string"
    },
    "robots": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Robots",
      "type": "array"
    },
    "streams": {
      "items": {
        "enum": [
          "state",
          "rgb",
          "depth",
          "lidar",
          "map"
        ],
        "type": "string"
      },
      "title": "Streams",
      "type": "array"
    },
    "t": {
      "const": "sub",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "t",
    "robots",
    "streams"
  ],
  "title": "ScreenSub",
  "type": "object"
}
