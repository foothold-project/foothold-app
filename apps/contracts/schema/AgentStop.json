{
  "$id": "fh-app/1/AgentStop",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "by_user_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "By User Id"
    },
    "cause": {
      "anyOf": [
        {
          "enum": [
            "unknown",
            "user_stop",
            "lease_release",
            "lease_expired",
            "lease_take",
            "lease_transfer",
            "run_takeover",
            "transfer_canceled",
            "screen_hidden",
            "access_revoked",
            "robot_changed",
            "screen_auth_revoked",
            "screen_policy_stale",
            "screen_disconnected",
            "agent_auth_revoked",
            "agent_policy_stale",
            "agent_connected",
            "agent_disconnected",
            "agent_silent",
            "field_approval_revoked",
            "audit_unavailable",
            "run_finished",
            "transfer_access_lost",
            "archive_blocked",
            "drive_command_rejected",
            "drive_frame_invalid",
            "drive_settings_changed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cause"
    },
    "stop_ref": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Stop Ref",
      "type": "integer"
    },
    "t": {
      "const": "stop",
      "default": "stop",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "by_user_id",
    "stop_ref"
  ],
  "title": "AgentStop",
  "type": "object"
}
