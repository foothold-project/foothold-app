{
  "$id": "fh-app/1/SimRobot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_address": {
      "title": "Agent Address",
      "type": "string"
    },
    "command_topic": {
      "title": "Command Topic",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "generation": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "launcher": {
      "enum": [
        "fake",
        "native-single"
      ],
      "title": "Launcher",
      "type": "string"
    },
    "namespace": {
      "title": "Namespace",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "remaining_s": {
      "anyOf": [
        {
          "maximum": 3600,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Manager monotonic runtime remaining at this response, in seconds.",
      "title": "Remaining S"
    },
    "robot_id": {
      "format": "uuid",
      "title": "Robot Id",
      "type": "string"
    },
    "simulation": {
      "const": true,
      "title": "Simulation",
      "type": "boolean"
    },
    "spawn_floor_id": {
      "anyOf": [
        {
          "enum": [
            "l1",
            "l2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spawn Floor Id"
    },
    "state": {
      "enum": [
        "STARTING",
        "PREPARED",
        "RUNNING",
        "STOPPING",
        "ERROR"
      ],
      "title": "State",
      "type": "string"
    },
    "tf_prefix": {
      "title": "Tf Prefix",
      "type": "string"
    },
    "world_id": {
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "generation",
    "robot_id",
    "owner_id",
    "world_id",
    "simulation",
    "state",
    "agent_address",
    "namespace",
    "tf_prefix",
    "command_topic",
    "launcher",
    "expires_at",
    "remaining_s"
  ],
  "title": "SimRobot",
  "type": "object"
}
