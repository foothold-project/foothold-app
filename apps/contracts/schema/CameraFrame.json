{
  "$id": "fh-app/1/CameraFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "height": {
      "maximum": 360,
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "jpeg": {
      "maxLength": 87384,
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "title": "Jpeg",
      "type": "string"
    },
    "mime": {
      "const": "image/jpeg",
      "title": "Mime",
      "type": "string"
    },
    "robot": {
      "description": "소문자 하이픈 UUID 표준형만 허용한다.",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Robot",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "t": {
      "const": "camera.frame",
      "title": "T",
      "type": "string"
    },
    "width": {
      "maximum": 640,
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "t",
    "robot",
    "seq",
    "mime",
    "width",
    "height",
    "jpeg"
  ],
  "title": "CameraFrame",
  "type": "object"
}
