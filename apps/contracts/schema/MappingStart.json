{
  "$id": "fh-app/1/MappingStart",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "floor_id": {
      "format": "uuid",
      "title": "Floor Id",
      "type": "string"
    },
    "name": {
      "default": "로봇이 만든 지도",
      "maxLength": 40,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "source": {
      "default": "unitree_uslam",
      "enum": [
        "unitree_uslam",
        "legacy"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "floor_id"
  ],
  "title": "MappingStart",
  "type": "object"
}
