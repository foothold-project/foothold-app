{
  "$id": "fh-app/1/MappingStart",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "floor_id": {
      "format": "uuid",
      "title": "Floor Id",
      "type": "string"
    },
    "name": {
      "default": "로봇이 만든 지도",
      "maxLength": 40,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "const": "point_lio",
          "type": "string"
        },
        {
          "const": "legacy",
          "type": "string"
        }
      ],
      "default": "legacy",
      "description": "Omitted source preserves legacy four-key commands; send point_lio explicitly for the Point-LIO/GLIM pipeline.",
      "title": "Source"
    }
  },
  "required": [
    "floor_id"
  ],
  "title": "MappingStart",
  "type": "object"
}
