{
  "$defs": {
    "AgentBattery": {
      "properties": {
        "soc": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Soc"
        },
        "voltage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage"
        }
      },
      "required": [
        "soc"
      ],
      "title": "AgentBattery",
      "type": "object"
    },
    "AgentPose": {
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "floor_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Floor Id"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Y"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yaw"
        }
      },
      "required": [
        "floor_id",
        "x",
        "y",
        "yaw",
        "confidence"
      ],
      "title": "AgentPose",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CAMERA_RGB",
            "CAMERA_DEPTH",
            "LIDAR",
            "BATTERY",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "OK",
            "MISSING",
            "ERROR"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "state"
      ],
      "title": "Device",
      "type": "object"
    }
  },
  "$id": "fh-app/1/AgentState",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "applied": {
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Applied",
      "type": "array"
    },
    "battery": {
      "$ref": "#/$defs/AgentBattery"
    },
    "devices_changed": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Device"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Devices Changed"
    },
    "latched": {
      "title": "Latched",
      "type": "boolean"
    },
    "mode": {
      "maxLength": 64,
      "title": "Mode",
      "type": "string"
    },
    "pose": {
      "$ref": "#/$defs/AgentPose"
    },
    "speed": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Speed"
    },
    "stop_gen": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Stop Gen",
      "type": "integer"
    },
    "stop_ref": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Stop Ref",
      "type": "integer"
    },
    "t": {
      "const": "state",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "pose",
    "speed",
    "battery",
    "latched",
    "stop_gen",
    "stop_ref",
    "applied",
    "mode"
  ],
  "title": "AgentState",
  "type": "object"
}
