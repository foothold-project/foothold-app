{
  "$id": "fh-app/1/AgentUnlock",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "stop_gen": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Stop Gen",
      "type": "integer"
    },
    "t": {
      "const": "unlock",
      "default": "unlock",
      "title": "T",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    }
  },
  "required": [
    "t",
    "lease_id",
    "stop_gen"
  ],
  "title": "AgentUnlock",
  "type": "object"
}
