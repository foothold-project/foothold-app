  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "stop_gen": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Stop Gen",
      "type": "integer"
    },
    "t": {
      "const": "unlock",
      "default": "unlock",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "lease_id",
    "stop_gen"
  ],
  "title": "AgentUnlock",
  "type": "object"
}
