{
  "$id": "fh-app/1/RunMapProof",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable map bytes/geometry; UUID is an identifier, never a content digest.",
  "properties": {
    "floor_id": {
      "format": "uuid",
      "title": "Floor Id",
      "type": "string"
    },
    "height": {
      "exclusiveMinimum": 0,
      "maximum": 4096,
      "title": "Height",
      "type": "integer"
    },
    "image_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Image Sha256",
      "type": "string"
    },
    "map_version_id": {
      "format": "uuid",
      "title": "Map Version Id",
      "type": "string"
    },
    "origin": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Origin",
      "type": "array"
    },
    "resolution": {
      "exclusiveMinimum": 0,
      "title": "Resolution",
      "type": "number"
    },
    "ros_floor_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ros Floor Id"
    },
    "source": {
      "enum": [
        "HUMAN",
        "SIMULATION"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_pgm_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Pgm Sha256",
      "type": "string"
    },
    "width": {
      "exclusiveMinimum": 0,
      "maximum": 4096,
      "title": "Width",
      "type": "integer"
    },
    "world_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "World Id"
    }
  },
  "required": [
    "floor_id",
    "map_version_id",
    "image_sha256",
    "source_pgm_sha256",
    "origin",
    "resolution",
    "width",
    "height",
    "source",
    "world_id",
    "ros_floor_id"
  ],
  "title": "RunMapProof",
  "type": "object"
}
