{
  "$id": "fh-app/1/Assignment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "memo": {
      "default": "",
      "maxLength": 2000,
      "title": "Memo",
      "type": "string"
    },
    "removed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Removed At"
    },
    "robot_id": {
      "format": "uuid",
      "title": "Robot Id",
      "type": "string"
    },
    "robot_name": {
      "title": "Robot Name",
      "type": "string"
    },
    "scenario_id": {
      "format": "uuid",
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_name": {
      "title": "Scenario Name",
      "type": "string"
    },
    "scenario_version": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Scenario Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "PENDING",
        "ACTIVE",
        "REJECTED",
        "REMOVED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "scenario_version",
    "robot_id",
    "memo",
    "id",
    "scenario_name",
    "robot_name",
    "status",
    "approval_id",
    "created_by",
    "created_at",
    "removed_at"
  ],
  "title": "Assignment",
  "type": "object"
}
