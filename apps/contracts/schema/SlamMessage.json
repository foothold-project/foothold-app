{
  "$defs": {
    "MediaPose": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "maximum": 3.141592653589793,
          "minimum": -3.141592653589793,
          "title": "Yaw",
          "type": "number"
        },
        "z": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "yaw"
      ],
      "title": "MediaPose",
      "type": "object"
    },
    "SlamPointCloudHeader": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "maximum": 48000,
          "minimum": 12,
          "title": "Byte Length",
          "type": "integer"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "channel": {
          "const": "slam",
          "title": "Channel",
          "type": "string"
        },
        "count": {
          "maximum": 4000,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "encoding": {
          "const": "xyz_f32le",
          "title": "Encoding",
          "type": "string"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "null"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "frame": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_/-]+$",
          "title": "Frame",
          "type": "string"
        },
        "robot": {
          "description": "소문자 하이픈 UUID 표준형만 허용한다.",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Robot",
          "type": "string"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "const": "rt/uslam/frontend/cloud_world_ds",
          "title": "Source",
          "type": "string"
        },
        "t": {
          "const": "media.slam_points",
          "title": "T",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "version": {
          "const": "media/1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "robot",
        "epoch",
        "episode_id",
        "version",
        "captured_at",
        "seq",
        "frame",
        "t",
        "channel",
        "source",
        "count",
        "truncated",
        "encoding",
        "byte_length"
      ],
      "title": "SlamPointCloudHeader",
      "type": "object"
    },
    "SlamPoseFrame": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "channel": {
          "const": "slam_pose",
          "title": "Channel",
          "type": "string"
        },
        "child_frame": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_/-]+$",
          "title": "Child Frame",
          "type": "string"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "null"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "frame": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_/-]+$",
          "title": "Frame",
          "type": "string"
        },
        "pose": {
          "$ref": "#/$defs/MediaPose"
        },
        "robot": {
          "description": "소문자 하이픈 UUID 표준형만 허용한다.",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Robot",
          "type": "string"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "enum": [
            "rt/uslam/frontend/odom",
            "rt/uslam/localization/odom"
          ],
          "title": "Source",
          "type": "string"
        },
        "t": {
          "const": "media.slam_pose",
          "title": "T",
          "type": "string"
        },
        "version": {
          "const": "media/1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "robot",
        "epoch",
        "episode_id",
        "version",
        "captured_at",
        "seq",
        "frame",
        "t",
        "channel",
        "source",
        "child_frame",
        "pose"
      ],
      "title": "SlamPoseFrame",
      "type": "object"
    },
    "SlamStatus": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "slam",
            "slam_pose"
          ],
          "title": "Channel",
          "type": "string"
        },
        "episode_id": {
          "title": "Episode Id",
          "type": "null"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "reason": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "robot": {
          "description": "소문자 하이픈 UUID 표준형만 허용한다.",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Robot",
          "type": "string"
        },
        "state": {
          "const": "NO_SLAM",
          "title": "State",
          "type": "string"
        },
        "t": {
          "const": "media.status",
          "title": "T",
          "type": "string"
        },
        "version": {
          "const": "media/1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "robot",
        "epoch",
        "episode_id",
        "t",
        "version",
        "channel",
        "state",
        "reason"
      ],
      "title": "SlamStatus",
      "type": "object"
    }
  },
  "$id": "fh-app/1/SlamMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "media.slam_points": "#/$defs/SlamPointCloudHeader",
      "media.slam_pose": "#/$defs/SlamPoseFrame",
      "media.status": "#/$defs/SlamStatus"
    },
    "propertyName": "t"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SlamPointCloudHeader"
    },
    {
      "$ref": "#/$defs/SlamPoseFrame"
    },
    {
      "$ref": "#/$defs/SlamStatus"
    }
  ]
}
