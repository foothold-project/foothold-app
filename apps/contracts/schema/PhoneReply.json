{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "detail"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "RunResumeDetail": {
      "additionalProperties": false,
      "properties": {
        "resume_token": {
          "description": "256 bit 이상 난수. 원래/재바인딩된 실행 연결에만 반환하며 기록·보기 연결에는 금지한다.",
          "minLength": 1,
          "title": "Resume Token",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "screen_id": {
          "format": "uuid",
          "title": "Screen Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "screen_id",
        "resume_token"
      ],
      "title": "RunResumeDetail",
      "type": "object"
    }
  },
  "$id": "fh-app/1/PhoneReply",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunResumeDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lease Id"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "request_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Request Id"
    },
    "t": {
      "const": "reply",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "t",
    "id",
    "ok",
    "error",
    "lease_id",
    "request_id"
  ],
  "title": "PhoneReply",
  "type": "object"
}
