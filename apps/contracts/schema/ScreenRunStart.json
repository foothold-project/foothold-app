{
  "$id": "fh-app/1/ScreenRunStart",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "format": "uuid",
      "title": "Assignment Id",
      "type": "string"
    },
    "floor_id": {
      "format": "uuid",
      "title": "Floor Id",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "map_version_id": {
      "format": "uuid",
      "title": "Map Version Id",
      "type": "string"
    },
    "proto": {
      "const": "fh-rt/1",
      "description": "첫 메시지는 필수, 후속은 생략 가능; null은 거부한다.",
      "title": "Proto",
      "type": "string"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "format": "uuid",
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "minimum": 1,
      "title": "Scenario Version",
      "type": "integer"
    },
    "screen_id": {
      "format": "uuid",
      "title": "Screen Id",
      "type": "string"
    },
    "t": {
      "const": "run.start",
      "title": "T",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot",
    "t",
    "lease_id",
    "run_id",
    "screen_id",
    "scenario_id",
    "scenario_version",
    "floor_id",
    "map_version_id",
    "assignment_id"
  ],
  "title": "ScreenRunStart",
  "type": "object"
}
