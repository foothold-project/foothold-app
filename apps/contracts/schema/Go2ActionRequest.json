{
  "$defs": {
    "Go2ActionParams": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "mode": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "pitch": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch"
        },
        "roll": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roll"
        },
        "yaw": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yaw"
        }
      },
      "title": "Go2ActionParams",
      "type": "object"
    }
  },
  "$id": "fh-app/1/Go2ActionRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "Damp",
        "BalanceStand",
        "StopMove",
        "StandUp",
        "StandDown",
        "RecoveryStand",
        "Euler",
        "Sit",
        "RiseSit",
        "SpeedLevel",
        "Hello",
        "Stretch",
        "Content",
        "Dance1",
        "Dance2",
        "SwitchJoystick",
        "Pose",
        "Scrape",
        "FrontFlip",
        "FrontJump",
        "FrontPounce",
        "Heart",
        "StaticWalk",
        "TrotRun",
        "EconomicGait",
        "LeftFlip",
        "BackFlip",
        "HandStand",
        "FreeWalk",
        "FreeBound",
        "FreeJump",
        "FreeAvoid",
        "ClassicWalk",
        "WalkUpright",
        "CrossStep",
        "AutoRecoverySet",
        "AutoRecoveryGet",
        "SwitchAvoidMode",
        "CheckMode",
        "SelectMode",
        "Greet"
      ],
      "title": "Action",
      "type": "string"
    },
    "confirmed": {
      "default": false,
      "title": "Confirmed",
      "type": "boolean"
    },
    "params": {
      "$ref": "#/$defs/Go2ActionParams"
    }
  },
  "required": [
    "action",
    "params",
    "confirmed"
  ],
  "title": "Go2ActionRequest",
  "type": "object"
}
