{
  "$id": "fh-app/1/AgentServerPing",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ping_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ping Id"
    },
    "t": {
      "const": "ping",
      "default": "ping",
      "title": "T",
      "type": "string"
    },
    "t_server": {
      "format": "date-time",
      "title": "T Server",
      "type": "string"
    }
  },
  "required": [
    "t",
    "t_server",
    "ping_id"
  ],
  "title": "AgentServerPing",
  "type": "object"
}
