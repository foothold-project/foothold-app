{
  "$id": "fh-app/1/ScreenRobot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "proto": {
      "const": "fh-rt/1",
      "description": "첫 메시지는 필수, 후속은 생략 가능; null은 거부한다.",
      "title": "Proto",
      "type": "string"
    },
    "robot": {
      "format": "uuid",
      "title": "Robot",
      "type": "string"
    }
  },
  "required": [
    "id",
    "robot"
  ],
  "title": "ScreenRobot",
  "type": "object"
}
