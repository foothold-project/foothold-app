{
  "$id": "fh-app/1/SimWorldStart",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "spawn_floor_id": {
      "anyOf": [
        {
          "enum": [
            "l1",
            "l2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spawn Floor Id"
    },
    "world_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "World Id",
      "type": "string"
    }
  },
  "required": [
    "world_id"
  ],
  "title": "SimWorldStart",
  "type": "object"
}
