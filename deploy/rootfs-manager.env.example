# Root-only input; independent secret/key files belong to the dedicated UID.
# Replace private UUIDs/origin/credential paths after review; never commit values.
FH_SIM_RUN=1
FH_SIM_DOMAIN=93
FH_SIM_MAX_ROBOTS=1
FH_SIM_PORT=9430
FH_SIM_AGENT_HOST=127.0.0.1
FH_SIM_AGENT_WS_URL=ws://127.0.0.1:8810/api/v1/agent/ws
FH_SIM_CATALOG=/etc/foothold-sim/catalogue.json
FH_SIM_AUTH_FILE=/etc/foothold-sim/manager-secret
FH_SIM_RUNTIME_SECONDS=1800
FH_SIM_NATIVE_PYTHON_DIR=/opt/foothold-sim/python-vendor
FH_SIM_EXTRA_PORTS=8810
SIM_SOURCE=/opt/foothold-sim/assets/source/sensor-spec-20261016/stage/sensor-runtime-r1
SIM_ROS_SETUP=/foothold-runtime/ros-setup.bash
SIM_RUN_DIR=/opt/foothold/current/runs/server-sim
FH_SIM_AGENT_PYTHON=/usr/bin/python3
FOOTHOLD_SCENARIO_DATA_ORIGIN=http://127.0.0.1:8810
FOOTHOLD_PHONE_ORIGINS='["https://control.example.org"]'
# FH_SIM_ROOTFS_LOCK, guard, proof socket and code path are fixed by ExecStart.
# No host DB URL, ROS_*, LD_LIBRARY_PATH, PYTHONPATH or SYSROOT_PROFILE here.
