[Unit]
Description=Foothold read-only fixed-field OS isolation proof

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I -B /opt/foothold/deploy-tools/proc_proof_server.py
User=root
Group=root
StandardInput=socket
StandardOutput=socket
StandardError=null
Restart=no
RuntimeMaxSec=5
TimeoutStopSec=1
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=8
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=~ptrace process_vm_readv process_vm_writev kill tkill tgkill mount umount2 reboot swapon swapoff init_module finit_module delete_module
