# 로컬 compose 값. 복사해서 채운다: cp deploy/local/.env.example deploy/local/.env
# .env 는 저장소에 올리지 않는다 (.gitignore). 운영 서버 · 공유 DB 의 값을 넣지 않는다.
# 비밀번호는 이 컴퓨터 안에서만 쓰는 새 값으로 (예: python3 -c "import secrets;print(secrets.token_urlsafe(24))").

# 로컬 postgres 관리자 (init 단계에서만 쓴다. server 에는 가지 않는다)
FH_LOCAL_DB_ADMIN_PASSWORD=
# 서버 DB 역할 셋 (apps/server/README.md)
FH_MIGRATE_PASSWORD=
FH_APP_PASSWORD=
FH_READONLY_PASSWORD=

# 첫 조직 (UUID 하나 새로: python3 -c "import uuid;print(uuid.uuid4())")
FH_ORG_ID=
FH_ORG_NAME=로컬
# 첫 총괄 계정 (웹 로그인)
FH_BOOTSTRAP_USERNAME=admin
FH_BOOTSTRAP_DISPLAY_NAME=로컬 총괄
FH_BOOTSTRAP_PASSWORD=

# 브라우저가 여는 주소 https://localhost:<이 값>
FH_LOCAL_HTTPS_PORT=8443

# MuJoCo 시뮬 비공개 자산 폴더 (정책 f32 · MuJoCo 3.17.0 런타임 · three · Go2 메시).
# 구조와 SHA 는 deploy/README.md 「시뮬」 절. 비워 두면 /sim/ 없이 웹만 뜬다.
FH_SIM_ASSETS=

# 가짜 로봇 · 기록 재생 자리 (compose 의 robot 서비스 · 아직 미구현이라 지금은 읽는 곳 없음).
# 토큰은 웹 총괄이 로봇을 만들 때 한 번 보이는 agent_token, 또는 「+ 로봇 연결하기」 일회용 코드로 받은 값.
FOOTHOLD_ROBOT_ID=
FOOTHOLD_AGENT_TOKEN=
# 재생할 실기 기록 폴더 (예: 20261119-2229-lodging-full 을 둔 자리)
FH_LOCAL_REPLAY_DIR=
# 실기 로봇 주소 · NIC (실기는 서버를 마지막에 붙인다: 로컬 판에서는 쓰지 않는다)
FH_LOCAL_ROBOT_ADDRESS=
FH_LOCAL_ROBOT_NIC=
