# Root:foothold-sim 0640. Paths are examples; replace privately on the server.
FH_SIM_CATALOG=/etc/foothold-sim/catalogue.json
FH_SIM_AUTH_FILE=/etc/foothold-sim/manager.secret
FH_SIM_RUN=1
FH_SIM_DOMAIN=93
FH_SIM_MAX_ROBOTS=1
FH_SIM_EXTRA_PORTS=8810
FH_SIM_AGENT_WS_URL=ws://127.0.0.1:8810/api/v1/agent/ws
FH_SIM_AGENT_PYTHON=/opt/foothold/current/.venv/bin/python
FH_SIM_RUNTIME_SECONDS=1800
SIM_SOURCE=/private/simulation/sensor-spec-20261016/stage/sensor-runtime-r1
SIM_ROS_SETUP=/opt/ros/jazzy/setup.bash
SIM_RUN_DIR=/opt/foothold/current/runs/server-sim
FH_SIM_NATIVE_PYTHON_DIR=/opt/foothold-sim/python-vendor
FOOTHOLD_SCENARIO_DATA_ORIGIN=http://127.0.0.1:8810
FOOTHOLD_PHONE_ORIGINS='["https://simulation.example.invalid"]'
# ROS_*, RMW_*, DDS and database credentials must never enter the manager env.
